/* ===========================================================
   re:SquashStrike UI kit (UI redesign U1) - the "feels like a game"
   components. Same identity as Theme.uss: lime #c8ff3d on charcoal,
   Rajdhani headings, JetBrains Mono numbers. Space first: a 96 px safe
   margin, 24-32 px between cards, one primary action bottom right.
   =========================================================== */

/* ---------- the screen ---------- */
.k-screen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; width: auto; padding: 0; background-image: none; }
.k-fade { position: absolute; left: 0; right: 0; bottom: 0; height: 70%; -unity-background-scale-mode: stretch-to-fill; }
.k-content { position: absolute; left: 96px; right: 96px; top: 168px; bottom: 120px; }
.k-page { flex-grow: 1; }

/* ---------- top bar ---------- */
.k-topbar { position: absolute; left: 96px; right: 96px; top: 44px; height: 96px; flex-direction: row; align-items: center; justify-content: space-between; }
.k-topbar-left { min-width: 360px; }
.k-topbar-left .fe-kicker { font-size: 13px; margin-bottom: 2px; }
.k-topbar-left .fe-title { font-size: 44px; margin-bottom: 0; }

/* ---------- tabs ---------- */
.k-tabs { flex-direction: row; align-items: center; }
.k-tab {
    font-size: 24px; letter-spacing: 3px; margin: 0 18px; padding: 6px 2px;
    color: rgba(255, 255, 255, 0.5); border-bottom-width: 3px; border-bottom-color: rgba(0, 0, 0, 0);
    -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold");
    transition-property: color, border-bottom-color; transition-duration: 0.15s;
}
.k-tab--on { color: rgb(255, 255, 255); border-bottom-color: rgb(200, 255, 61); }
.k-tab-glyph {
    font-size: 11px; color: rgba(255, 255, 255, 0.55); padding: 2px 7px; border-width: 1px; border-color: rgba(255, 255, 255, 0.18); border-radius: 4px;
    -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold");
}

/* ---------- the player chip ---------- */
.k-chip {
    flex-direction: row; align-items: center; padding: 6px 18px 6px 8px; border-radius: 40px;
    background-color: rgba(16, 18, 22, 0.88); border-width: 1px; border-color: rgba(255, 255, 255, 0.09); border-left-width: 4px;
}
.k-chip-ringbox { width: 48px; height: 48px; margin-right: 12px; justify-content: center; align-items: center; }
.k-ring { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.k-chip-level { font-size: 19px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-chip-title { font-size: 10px; letter-spacing: 2px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-chip-name { font-size: 20px; margin-top: -2px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }

/* ---------- cards ---------- */
.k-row { flex-direction: row; align-items: flex-end; justify-content: flex-start; flex-grow: 1; }
.k-card {
    position: relative; overflow: hidden; margin-right: 26px; border-radius: 14px;
    background-color: rgb(21, 23, 28); border-width: 1px; border-color: rgba(255, 255, 255, 0.09);
    transition-property: scale, border-color, translate; transition-duration: 0.14s;
}
.k-card--s { width: 240px; height: 200px; }
.k-card--m { width: 300px; height: 330px; }
.k-card--l { width: 400px; height: 360px; }
.k-card--hero { width: 520px; height: 400px; }
.k-card.fe-item--focused {
    scale: 1.04 1.04; translate: 0 -6px; border-width: 2px; border-color: rgb(200, 255, 61);
}
.k-card-art { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: scale-and-crop; justify-content: center; align-items: center; }
.k-card-shade { position: absolute; left: 0; right: 0; bottom: 0; height: 58%; background-color: rgba(8, 9, 11, 0.78); }
.k-card--live .k-card-shade { height: 42%; background-color: rgba(8, 9, 11, 0.82); }
.k-card-body { position: absolute; left: 22px; right: 22px; bottom: 20px; }
.k-card-kicker { font-size: 11px; letter-spacing: 3px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-card-title { font-size: 32px; margin: -2px 0 0 0; white-space: normal; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-card--hero .k-card-title { font-size: 46px; }
.k-card--s .k-card-title { font-size: 24px; }
.k-card-line { font-size: 12px; margin-top: 4px; color: rgba(255, 255, 255, 0.78); white-space: normal; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }
.k-card-lock { font-size: 11px; margin-top: 6px; color: rgba(255, 255, 255, 0.7); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-card--locked .k-card-art { opacity: 0.35; }
.k-card--locked .k-card-title { color: rgba(255, 255, 255, 0.55); }
.k-card-glyph { font-size: 120px; color: rgba(200, 255, 61, 0.85); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-badge {
    position: absolute; top: 14px; right: 14px; padding: 3px 10px; border-radius: 20px;
    background-color: rgba(14, 15, 18, 0.88); border-width: 1px; border-color: rgba(200, 255, 61, 0.45);
    font-size: 12px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold");
}
.k-badge--lime { background-color: rgb(200, 255, 61); color: rgb(14, 15, 18); border-width: 0; }
.k-new {
    position: absolute; top: 14px; left: 14px; padding: 3px 9px; border-radius: 4px; background-color: rgb(255, 74, 64);
    font-size: 11px; letter-spacing: 2px; color: rgb(255, 255, 255); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold");
}


/* ---------- the primary action ---------- */
.k-primary {
    position: absolute; right: 96px; bottom: 42px; padding: 12px 34px; border-radius: 6px;
    background-color: rgb(200, 255, 61); border-width: 0;
    transition-property: scale; transition-duration: 0.12s;
}
.k-primary.fe-item--focused { scale: 1.07 1.07; border-width: 3px; border-color: rgb(255, 255, 255); }
.k-primary-label { font-size: 28px; letter-spacing: 3px; color: rgb(14, 15, 18); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }

/* ---------- prompts ---------- */
.k-prompts { position: absolute; left: 96px; bottom: 52px; flex-direction: row; align-items: center; }
.k-prompt { flex-direction: row; align-items: center; margin-right: 26px; }
.k-glyph {
    min-width: 24px; height: 24px; padding: 0 6px; border-radius: 12px; margin-right: 8px; -unity-text-align: middle-center;
    font-size: 12px; color: rgb(14, 15, 18); background-color: rgb(220, 222, 226); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold");
}
.k-glyph--key { border-radius: 4px; }
.k-glyph--a { background-color: rgb(111, 220, 75); }
.k-glyph--b { background-color: rgb(255, 90, 74); }
.k-glyph--x { background-color: rgb(74, 168, 255); }
.k-glyph--y { background-color: rgb(255, 207, 58); }
.k-prompt-text { font-size: 13px; color: rgba(255, 255, 255, 0.7); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }

/* ---------- selectors ---------- */
.k-sel { flex-direction: row; align-items: center; height: 62px; padding: 0 18px; margin-bottom: 10px; border-radius: 10px; background-color: rgba(255, 255, 255, 0.04); border-width: 1px; border-color: rgba(255, 255, 255, 0.08); }
.k-sel.fe-item--focused { border-color: rgb(200, 255, 61); background-color: rgba(200, 255, 61, 0.08); }
.k-sel-label { width: 170px; font-size: 22px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-sel-strip { flex-direction: row; align-items: center; flex-grow: 1; }
.k-pill {
    padding: 6px 16px; margin-right: 8px; border-radius: 20px; font-size: 16px; color: rgba(255, 255, 255, 0.6);
    background-color: rgba(255, 255, 255, 0.05); border-width: 1px; border-color: rgba(255, 255, 255, 0.1);
    -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold");
}
.k-pill.k-on { color: rgb(14, 15, 18); background-color: rgb(200, 255, 61); border-color: rgb(200, 255, 61); }
.k-pip { width: 46px; height: 12px; margin-right: 6px; border-radius: 6px; background-color: rgba(255, 255, 255, 0.12); }
.k-pip.k-on, .k-pip.k-past { background-color: rgb(200, 255, 61); }
.k-sel-caption { font-size: 18px; margin-left: 12px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }

/* ---------- panels and grids ---------- */
.k-panel { padding: 18px 22px; margin: 0 20px 20px 0; border-radius: 14px; background-color: rgba(16, 18, 22, 0.88); border-width: 1px; border-color: rgba(255, 255, 255, 0.08); }
.k-panel-title { font-size: 11px; letter-spacing: 3px; color: rgb(200, 255, 61); margin-bottom: 12px; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-page { flex-direction: column; }
.k-grid3 { flex-direction: row; }
.k-grid3 > .k-panel { flex-grow: 1; flex-basis: 0; }
.k-grid2 { flex-direction: row; }
.k-grid2 > .k-panel { flex-grow: 1; }

/* ---------- tiers ---------- */
.k-tierrow { flex-direction: row; flex-wrap: wrap; }
.k-tieritem { align-items: center; width: 110px; margin: 0 6px 10px 0; }
.k-tier-name { font-size: 11px; margin-top: 6px; letter-spacing: 1px; color: rgba(255, 255, 255, 0.75); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }

/* ---------- stat bars ---------- */
.k-statbars { min-width: 420px; }
.k-sb-row { flex-direction: row; align-items: center; height: 30px; }
.k-sb-val { width: 52px; font-size: 18px; color: rgba(255, 255, 255, 0.75); -unity-text-align: middle-center; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-sb-val--win { color: rgb(200, 255, 61); }
.k-sb-bar { flex-grow: 1; height: 8px; border-radius: 4px; background-color: rgba(255, 255, 255, 0.07); flex-direction: row; }
.k-sb-bar--a { justify-content: flex-end; }
.k-sb-fill { height: 8px; border-radius: 4px; background-color: rgba(255, 255, 255, 0.35); }
.k-sb-fill--win { background-color: rgb(200, 255, 61); }
.k-sb-name { width: 130px; font-size: 11px; letter-spacing: 1px; color: rgba(255, 255, 255, 0.65); -unity-text-align: middle-center; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }

/* ---------- ranked table ---------- */
.k-tr { flex-direction: row; align-items: center; height: 34px; padding: 0 10px; border-bottom-width: 1px; border-bottom-color: rgba(255, 255, 255, 0.06); }
.k-tr--you { background-color: rgba(200, 255, 61, 0.14); border-radius: 6px; border-bottom-width: 0; }
.k-tr-pos { width: 40px; font-size: 15px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-tr-move { width: 40px; font-size: 11px; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-up { color: rgb(111, 220, 75); } .k-down { color: rgb(255, 74, 64); } .k-same { color: rgba(255, 255, 255, 0.35); }
.k-tr-name { flex-grow: 1; font-size: 18px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-tr-chip { width: 46px; font-size: 11px; color: rgba(255, 255, 255, 0.55); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }
.k-tr-bar { width: 110px; height: 6px; border-radius: 3px; background-color: rgba(255, 255, 255, 0.07); margin-right: 10px; }
.k-tr-fill { height: 6px; border-radius: 3px; background-color: rgba(200, 255, 61, 0.7); }
.k-tr-pts { width: 66px; font-size: 14px; -unity-text-align: middle-right; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }

/* ---------- the bracket ---------- */
.k-bracket { position: relative; }
.k-bracket-lines { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.k-bracket-col { position: absolute; top: 0; width: 200px; }
.k-bracket-head { font-size: 10px; letter-spacing: 2px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-bm {
    flex-direction: row; align-items: center; padding: 0 10px; border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.05); border-width: 1px; border-color: rgba(255, 255, 255, 0.12);
    transition-property: border-color, scale; transition-duration: 0.12s;
}
.k-bm--you { background-color: rgba(200, 255, 61, 0.12); border-color: rgba(200, 255, 61, 0.7); }
.k-bm.fe-item--focused { border-width: 2px; border-color: rgb(255, 255, 255); scale: 1.04 1.04; }
.k-bm-names { flex-grow: 1; flex-shrink: 1; overflow: hidden; }
.k-bm-name { font-size: 13px; height: 20px; -unity-text-align: middle-left; padding: 0; margin: 0; color: rgba(255, 255, 255, 0.55); overflow: hidden; white-space: nowrap; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }
.k-bm-name--won { color: rgb(255, 255, 255); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-bm-name--you { color: rgb(200, 255, 61); }
.k-bm-name--tbd { color: rgba(255, 255, 255, 0.25); }
.k-bm-score { font-size: 10px; color: rgb(200, 255, 61); -unity-text-align: middle-right; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }

/* ---------- timeline ---------- */
.k-timeline { position: relative; min-height: 70px; }
.k-tl-line { position: absolute; left: 4%; right: 4%; top: 10px; height: 2px; background-color: rgba(255, 255, 255, 0.12); }
.k-tl-row { flex-direction: row; justify-content: space-between; }
.k-tl-node { align-items: center; flex-grow: 1; flex-basis: 0; }
.k-tl-dot { width: 20px; height: 20px; border-radius: 10px; margin-bottom: 6px; background-color: rgb(29, 32, 38); border-width: 2px; border-color: rgba(255, 255, 255, 0.2); }
.k-tl-dot--done { background-color: rgb(200, 255, 61); border-color: rgb(200, 255, 61); }
.k-tl-dot--now { background-color: rgb(14, 15, 18); border-color: rgb(200, 255, 61); border-width: 4px; }
.k-tl-label { font-size: 11px; color: rgba(255, 255, 255, 0.6); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-tl-note { font-size: 13px; color: rgb(255, 255, 255); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }

/* ---------- count-up and stamps ---------- */
.k-count { font-size: 72px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-stamp {
    align-self: flex-start; margin-top: 10px; padding: 4px 16px; border-width: 4px; border-color: rgb(255, 184, 59); border-radius: 6px;
    font-size: 34px; letter-spacing: 4px; color: rgb(255, 184, 59); rotate: -6deg;
    -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold");
    transition-property: scale, opacity; transition-duration: 0.18s; transition-timing-function: ease-out-back;
}
.k-stamp--in { scale: 2.2 2.2; opacity: 0; }

/* ---------- screen transitions ---------- */
.fe-screen { transition-property: opacity, translate, scale; transition-duration: 0.18s; transition-timing-function: ease-out-cubic; }
.fe-in-right { translate: 60px 0; opacity: 0; }
.fe-in-left { translate: -60px 0; opacity: 0; }
.fe-in-fade { opacity: 0; scale: 0.96 0.96; }

/* ================= U2: the hub, versus, pause, full time ================= */

/* ---------- action rows ---------- */
.k-action {
    flex-direction: row; align-items: center; justify-content: space-between; height: 58px; padding: 0 22px; margin-bottom: 10px;
    border-radius: 10px; background-color: rgba(255, 255, 255, 0.05); border-width: 1px; border-color: rgba(255, 255, 255, 0.09);
    transition-property: background-color, translate; transition-duration: 0.12s;
}
.k-action.fe-item--focused { background-color: rgb(200, 255, 61); border-color: rgb(200, 255, 61); translate: 6px 0; }
.k-action-label { font-size: 24px; letter-spacing: 1px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-action.fe-item--focused .k-action-label, .k-action.fe-item--focused .k-action-glyph { color: rgb(14, 15, 18); }
.k-action-glyph { font-size: 14px; color: rgba(255, 255, 255, 0.5); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-action--danger .k-action-label { color: rgb(255, 74, 64); }
.k-action--danger.fe-item--focused { background-color: rgb(255, 74, 64); border-color: rgb(255, 74, 64); }
.k-action--danger.fe-item--focused .k-action-label { color: rgb(14, 15, 18); }
/* the settings chip in the hub's top bar */
.k-action--chip { height: 44px; margin: 0 16px 0 auto; padding: 0 16px; border-radius: 22px; background-color: rgba(16, 18, 22, 0.88); }
.k-action--chip .k-action-label { font-size: 18px; margin-right: 10px; }
.k-action--chip .k-action-glyph { padding: 1px 7px; border-radius: 10px; background-color: rgb(255, 207, 58); color: rgb(14, 15, 18); }

/* ---------- versus ---------- */
.k-versus { flex-direction: row; flex-grow: 1; align-items: stretch; justify-content: space-between; }
.k-vs-side { width: 460px; align-items: flex-start; }
.k-vs-pic {
    width: 460px; height: 560px; border-radius: 16px; margin-bottom: 14px; overflow: hidden;
    border-width: 2px; border-color: rgba(255, 255, 255, 0.10); -unity-background-scale-mode: scale-and-crop; background-color: rgb(21, 23, 28);
}
.k-vs-kicker { font-size: 12px; letter-spacing: 3px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-vs-name { font-size: 54px; margin-top: -6px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-vs-meta { font-size: 13px; letter-spacing: 1px; color: rgba(255, 255, 255, 0.75); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-vs-lines { font-size: 13px; margin-top: 10px; color: rgba(255, 255, 255, 0.7); white-space: normal; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }
.k-vs-mid { width: 680px; justify-content: center; }
.k-vs-vs {
    font-size: 110px; align-self: center; margin-bottom: 20px; color: rgb(200, 255, 61);
    -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); text-shadow: 0 0 30px rgba(200, 255, 61, 0.6);
}
.k-vs-mid .k-sel-label { width: 140px; }

/* ---------- pause: a side panel ---------- */
.k-side {
    position: absolute; left: auto; right: 0; top: 0; bottom: 0; width: 600px;
    padding: 72px 64px 48px 64px; background-color: rgba(12, 13, 16, 0.96); border-left-width: 4px; border-left-color: rgb(200, 255, 61);
}
.k-side .fe-title { font-size: 56px; margin-bottom: 18px; }
.k-side-score { margin-bottom: 10px; padding: 10px 14px; border-radius: 10px; background-color: rgba(255, 255, 255, 0.04); }
.k-side-row { flex-direction: row; align-items: center; height: 40px; }
.k-side-serve { width: 20px; font-size: 12px; color: rgb(200, 255, 61); }
.k-side-name { flex-grow: 1; font-size: 22px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-side-games { width: 36px; font-size: 18px; color: rgba(255, 255, 255, 0.6); -unity-text-align: middle-center; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-side-points { width: 54px; font-size: 30px; color: rgb(200, 255, 61); -unity-text-align: middle-right; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-side-stats { font-size: 12px; color: rgba(255, 255, 255, 0.6); margin-bottom: 26px; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }
.k-prompts--side { left: 64px; bottom: 40px; }

/* ---------- full time ---------- */
.k-fulltime { position: absolute; left: 0; top: 0; right: 0; bottom: 0; width: auto; padding: 56px 96px 120px 96px; align-items: center; }
.k-fulltime .fe-kicker { font-size: 15px; letter-spacing: 6px; -unity-text-align: middle-center; }
.k-fulltime .fe-title {
    font-size: 96px; margin: -10px 0 0 0; color: rgb(200, 255, 61); -unity-text-align: middle-center;
    text-shadow: 0 0 30px rgba(200, 255, 61, 0.5);
}
.k-fulltime > VisualElement { align-self: stretch; }
.k-ft-head { flex-direction: row; justify-content: center; align-items: center; margin-top: -4px; }
.k-ft-name { width: 420px; font-size: 26px; -unity-text-align: middle-center; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-ft-games { font-size: 54px; margin: 0 30px; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-ft-chips { flex-direction: row; justify-content: center; margin: 8px 0 22px 0; }
.k-ft-chip { margin: 0 6px; padding: 3px 12px; border-radius: 14px; font-size: 14px; color: rgba(255, 255, 255, 0.7); background-color: rgba(255, 255, 255, 0.07); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-ft-chip--won { color: rgb(14, 15, 18); background-color: rgb(200, 255, 61); }
.k-ft-cols { flex-direction: row; justify-content: center; }
.k-ft-cols > .k-panel { width: 760px; }
.k-ft-right { width: 760px; }
.k-ft-highs { flex-direction: row; justify-content: space-around; }
.k-ft-high { align-items: center; }
.k-ft-high-v { font-size: 52px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-ft-high-n { font-size: 11px; letter-spacing: 2px; color: rgba(255, 255, 255, 0.6); margin-top: -6px; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-ft-more { position: absolute; left: 96px; bottom: 40px; flex-direction: row; }
.k-ft-more > .k-action { width: 280px; margin-right: 16px; margin-bottom: 0; }

/* ================= U3: the career ================= */
.k-cr-head { font-size: 12px; letter-spacing: 3px; color: rgb(200, 255, 61); margin-bottom: 12px; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-cr-note { font-size: 12px; margin-top: 10px; color: rgba(255, 255, 255, 0.6); white-space: normal; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }
.k-cr-empty { font-size: 13px; color: rgba(255, 255, 255, 0.55); white-space: normal; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }
.k-up { color: rgb(200, 255, 61); }
.k-down { color: rgb(255, 90, 74); }
.k-same { color: rgba(255, 255, 255, 0.4); }
.k-stamp--plain { border-color: rgb(255, 255, 255); color: rgb(255, 255, 255); }

/* ---------- central ---------- */
.k-cr-top { flex-direction: row; height: 450px; }
.k-cr-hero { flex-grow: 1; margin-right: 24px; }
.k-cr-hero > .k-row { align-items: flex-start; }
.k-card--match { width: 640px; height: 390px; }
.k-card--event { width: 270px; height: 390px; margin-right: 20px; }
.k-card--event .k-card-title { font-size: 28px; }
.k-cr-cardtier { position: absolute; left: 18px; top: 18px; }
.k-cr-rankw { width: 470px; margin: 0; }
.k-cr-rank-row { flex-direction: row; align-items: flex-end; }
.k-cr-rank-big { font-size: 84px; margin: -14px 0 -8px 0; color: rgb(255, 255, 255); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-cr-rank-move { font-size: 20px; margin: 0 0 14px 14px; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-cr-rank-sub { font-size: 12px; letter-spacing: 1px; color: rgba(255, 255, 255, 0.65); margin-bottom: 10px; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-cr-rankw .k-tr-bar { width: 70px; }
.k-cr-bottom { flex-direction: row; margin-top: 24px; align-items: flex-start; }
.k-cr-bottom > .k-panel { margin: 0 24px 0 0; }
.k-cr-news { flex-grow: 1.4; flex-basis: 0; }
.k-cr-season { flex-grow: 1; flex-basis: 0; margin-right: 0; }
.k-cr-news-row { flex-direction: row; }
.k-cr-news-item { flex-grow: 1; flex-basis: 0; margin-right: 18px; padding: 4px 0 4px 14px; border-left-width: 3px; border-left-color: rgba(200, 255, 61, 0.7); }
.k-cr-news-k { font-size: 10px; letter-spacing: 2px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-cr-news-t { font-size: 20px; margin-top: 4px; white-space: normal; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }

/* ---------- calendar ---------- */
.k-cr-cal { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.k-cr-month {
    width: 272px; height: 372px; margin-bottom: 20px; padding: 16px 16px; border-radius: 12px;
    background-color: rgba(16, 18, 22, 0.88); border-width: 1px; border-color: rgba(255, 255, 255, 0.08);
}
.k-cr-month--past { opacity: 0.6; }
.k-cr-month--now { border-width: 2px; border-color: rgb(200, 255, 61); background-color: rgba(24, 30, 18, 0.92); }
.k-cr-month-head { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 14px; }
.k-cr-month-name { font-size: 30px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-cr-now { padding: 2px 8px; border-radius: 10px; font-size: 10px; letter-spacing: 2px; color: rgb(14, 15, 18); background-color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-cr-ev { flex-direction: row; align-items: center; height: 30px; }
.k-cr-ev-name { font-size: 16px; margin-left: 10px; color: rgba(255, 255, 255, 0.85); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-cr-mine {
    position: absolute; left: 16px; right: 16px; bottom: 16px; padding: 6px 10px; border-radius: 6px; white-space: normal;
    font-size: 12px; color: rgb(255, 255, 255); background-color: rgba(255, 255, 255, 0.08); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold");
}
.k-cr-mine--won { color: rgb(14, 15, 18); background-color: rgb(255, 184, 59); }

/* ---------- rankings ---------- */
.k-cr-rgrid { flex-direction: row; flex-grow: 1; }
.k-cr-tablep { flex-grow: 1; margin-bottom: 0; }
.k-cr-tablep .k-tr-bar { width: 260px; }
.k-cr-tablebox { margin-top: 4px; }
.k-cr-ladder { width: 520px; margin: 0; }
.k-cr-lad { flex-direction: row; align-items: center; height: 92px; padding: 0 14px; margin-bottom: 10px; border-radius: 10px; background-color: rgba(255, 255, 255, 0.03); opacity: 0.55; }
.k-cr-lad--open { opacity: 1; background-color: rgba(200, 255, 61, 0.06); }
.k-cr-lad-text { flex-grow: 1; margin-left: 16px; }
.k-cr-lad-name { font-size: 24px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-cr-lad-line { font-size: 11px; color: rgba(255, 255, 255, 0.6); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }
.k-cr-lad-gate { font-size: 14px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }

/* ---------- player ---------- */
.k-cr-pgrid { flex-direction: row; flex-grow: 1; }
.k-cr-pgrid > .k-panel, .k-cr-pmid > .k-panel { margin: 0 24px 24px 0; }
.k-cr-pcard { width: 420px; margin-bottom: 0; }
.k-cr-ppic { width: 376px; height: 470px; border-radius: 10px; margin-bottom: 14px; -unity-background-scale-mode: scale-and-crop; background-color: rgb(21, 23, 28); }
.k-cr-pname { font-size: 44px; margin-top: -6px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-cr-pmeta { font-size: 12px; letter-spacing: 1px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-cr-pmid { flex-grow: 1; flex-basis: 0; }
.k-cr-bytier { flex-direction: row; flex-wrap: wrap; margin-top: 14px; }
.k-cr-bytier-item { flex-direction: row; align-items: center; width: 33%; height: 30px; }
.k-cr-bytier-n { font-size: 15px; margin-left: 8px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-cr-rival { flex-direction: row; align-items: center; height: 36px; }
.k-cr-rival-star { width: 24px; color: rgb(255, 184, 59); font-size: 16px; }
.k-cr-rival-name { flex-grow: 1; font-size: 20px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-cr-rival-h2h { font-size: 13px; color: rgba(255, 255, 255, 0.7); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-cr-hist { flex-grow: 1; flex-basis: 0; margin-right: 0; margin-bottom: 0; }
.k-cr-hrow { flex-direction: row; align-items: center; height: 58px; border-bottom-width: 1px; border-bottom-color: rgba(255, 255, 255, 0.06); }
.k-cr-hmid { flex-grow: 1; margin-left: 12px; }
.k-cr-hname { font-size: 18px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-cr-hline { font-size: 10px; color: rgba(255, 255, 255, 0.55); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }
.k-cr-hscore { font-size: 12px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }

/* ---------- chips and tiles ---------- */
.k-cr-form { flex-direction: row; }
.k-cr-form-none { font-size: 11px; color: rgba(255, 255, 255, 0.45); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }
.k-cr-chip {
    min-width: 30px; height: 24px; padding: 0 6px; margin: 0 3px; border-radius: 5px; -unity-text-align: middle-center;
    font-size: 11px; color: rgba(255, 255, 255, 0.7); background-color: rgba(255, 255, 255, 0.08); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold");
}
.k-cr-chip--w { color: rgb(14, 15, 18); background-color: rgb(200, 255, 61); }
.k-cr-chip--f { color: rgb(14, 15, 18); background-color: rgb(255, 184, 59); }
.k-cr-tiles { flex-direction: row; justify-content: center; }
.k-cr-tile { min-width: 220px; align-items: center; margin: 0 14px; padding: 14px 18px; border-radius: 12px; background-color: rgba(16, 18, 22, 0.88); border-width: 1px; border-color: rgba(255, 255, 255, 0.08); }
.k-cr-tile-v { font-size: 52px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-cr-tile-n { font-size: 11px; letter-spacing: 2px; color: rgba(255, 255, 255, 0.6); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-cr-tile-move { font-size: 12px; margin-top: 4px; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-cr-pmid .k-cr-tile { min-width: 0; flex-grow: 1; margin: 0 6px; }
.k-cr-pmid .k-cr-tile-v { font-size: 38px; }

/* ---------- match preview ---------- */
.k-vs-side--right { align-items: flex-end; }
.k-vs-side--right .k-vs-name, .k-vs-side--right .k-vs-meta { -unity-text-align: upper-right; }
.k-cr-pv-event { flex-direction: row; align-items: center; justify-content: center; margin-bottom: 14px; }
.k-cr-pv-round { font-size: 14px; letter-spacing: 3px; margin-left: 12px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-cr-tape-row { flex-direction: row; align-items: center; height: 46px; border-bottom-width: 1px; border-bottom-color: rgba(255, 255, 255, 0.06); }
.k-cr-tape-a { flex-grow: 1; flex-basis: 0; flex-direction: row; justify-content: flex-start; }
.k-cr-tape-b { flex-grow: 1; flex-basis: 0; flex-direction: row; justify-content: flex-end; }
.k-cr-tape-n { width: 200px; font-size: 11px; letter-spacing: 2px; -unity-text-align: middle-center; color: rgba(255, 255, 255, 0.55); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-cr-tape-v { font-size: 24px; color: rgba(255, 255, 255, 0.8); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-cr-tape-v--win { color: rgb(200, 255, 61); }
.k-cr-pv-acts { flex-direction: row; justify-content: center; margin-top: 16px; }
.k-cr-pv-acts > .k-action { width: 240px; margin: 0 8px; }
.k-cr-callout {
    align-self: flex-end; max-width: 460px; margin-top: 8px; padding: 6px 12px; border-radius: 6px; white-space: normal; -unity-text-align: middle-right;
    font-size: 13px; color: rgb(255, 255, 255); background-color: rgba(16, 18, 22, 0.88); border-right-width: 3px; border-right-color: rgb(200, 255, 61);
    -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium");
}
.k-cr-rivalkick { color: rgb(255, 184, 59); }

/* ---------- the draw ---------- */
.k-cr-draw { flex-direction: row; flex-grow: 1; }
.k-cr-draw-scroll { flex-grow: 1; margin-right: 24px; border-radius: 14px; background-color: rgba(12, 13, 16, 0.9); border-width: 1px; border-color: rgba(255, 255, 255, 0.08); }
.k-cr-draw-scroll .unity-scroll-view__content-container { padding: 22px 22px 22px 22px; }
.k-cr-draw .k-bm { background-color: rgba(28, 31, 38, 0.95); }
.k-cr-draw .k-bm--you { background-color: rgba(52, 66, 24, 0.95); }
.k-cr-draw-detail { width: 400px; margin: 0; }
.k-cr-champ { position: absolute; width: 200px; padding: 10px 14px; border-radius: 10px; border-width: 2px; border-color: rgb(255, 184, 59); background-color: rgba(30, 24, 12, 0.92); }
.k-cr-champ-k { font-size: 10px; letter-spacing: 3px; color: rgb(255, 184, 59); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-cr-champ-n { font-size: 22px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-cr-champ-n--you { color: rgb(200, 255, 61); }
.k-cr-dt-player { padding: 10px 14px; border-radius: 10px; background-color: rgba(255, 255, 255, 0.04); border-left-width: 3px; border-left-color: rgba(255, 255, 255, 0.15); }
.k-cr-dt-player--won { border-left-color: rgb(255, 255, 255); background-color: rgba(255, 255, 255, 0.08); }
.k-cr-dt-player--you { border-left-color: rgb(200, 255, 61); }
.k-cr-dt-name { font-size: 28px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-cr-dt-meta { font-size: 11px; letter-spacing: 1px; color: rgba(255, 255, 255, 0.6); white-space: normal; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-cr-dt-v { font-size: 18px; margin: 6px 0; -unity-text-align: middle-center; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-cr-dt-chips { flex-direction: row; margin: 16px 0 6px 0; }
.k-cr-dt-chips > .k-ft-chip { margin: 0 8px 0 0; }
.k-cr-dt-h2h { font-size: 12px; margin-top: 12px; color: rgba(255, 255, 255, 0.75); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }

/* ---------- results ---------- */
.k-cr-result { flex-grow: 1; align-items: center; justify-content: center; }
.k-cr-result--card { flex-grow: 0; align-self: center; width: 760px; margin-top: 110px; padding: 40px 40px 34px 40px; border-radius: 16px; background-color: rgba(12, 13, 16, 0.9); border-width: 1px; border-color: rgba(255, 255, 255, 0.08); }
.k-cr-result > .k-stamp { align-self: center; font-size: 72px; margin: 0 0 18px 0; }
.k-cr-preview .k-vs-pic { height: 470px; }
.k-cr-res-head { flex-direction: row; align-items: center; margin-bottom: 14px; }
.k-cr-res-head > .k-tier { margin-right: 22px; }
.k-cr-res-head > .k-stamp { align-self: center; margin-top: 0; font-size: 64px; }
.k-cr-res-k { font-size: 13px; letter-spacing: 3px; margin-right: 22px; color: rgba(255, 255, 255, 0.65); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-cr-res-v { font-size: 26px; margin: 10px 0 18px 0; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-cr-result > .k-cr-tiles { margin-bottom: 22px; }
.k-cr-result > .rw { width: 1000px; }
.k-cr-res-year { width: 1000px; margin: 8px 0 0 0; }

/* ---------- create a player ---------- */
.k-cr-create { flex-direction: row; flex-grow: 1; align-items: flex-start; }
.k-cr-steps { flex-grow: 1; margin-left: 40px; padding: 30px 40px 36px 40px; border-radius: 16px; background-color: rgba(12, 13, 16, 0.88); border-width: 1px; border-color: rgba(255, 255, 255, 0.08); }
.k-cr-dots { flex-direction: row; margin-bottom: 36px; }
.k-cr-dot {
    padding: 6px 16px; margin-right: 12px; border-radius: 16px; font-size: 13px; letter-spacing: 2px;
    color: rgba(255, 255, 255, 0.45); background-color: rgba(255, 255, 255, 0.05); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold");
}
.k-cr-dot--done { color: rgb(200, 255, 61); }
.k-cr-dot--on { color: rgb(14, 15, 18); background-color: rgb(200, 255, 61); }
.k-cr-step-q { font-size: 64px; margin-bottom: 24px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-cr-step-hint { font-size: 13px; margin-top: 18px; max-width: 760px; color: rgba(255, 255, 255, 0.6); white-space: normal; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }
.k-cr-name { width: 760px; flex-direction: row; align-items: center; height: 76px; padding: 0 18px; border-radius: 10px; background-color: rgba(255, 255, 255, 0.04); border-width: 1px; border-color: rgba(255, 255, 255, 0.08); }
.k-cr-name.fe-item--focused { border-color: rgb(200, 255, 61); background-color: rgba(200, 255, 61, 0.08); }
.k-cr-name .fe-item__label { width: 140px; font-size: 22px; }
.k-cr-name .fe-text { flex-grow: 1; }
.k-cr-step > .k-sel { width: 760px; }
.k-cr-summary { margin-top: 48px; font-size: 14px; letter-spacing: 2px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-carousel { flex-direction: row; align-items: center; width: 760px; height: 110px; padding: 0 18px; border-radius: 10px; background-color: rgba(255, 255, 255, 0.04); border-width: 1px; border-color: rgba(255, 255, 255, 0.08); }
.k-carousel.fe-item--focused { border-color: rgb(200, 255, 61); background-color: rgba(200, 255, 61, 0.08); }
.k-car-strip { flex-direction: row; align-items: center; flex-grow: 1; justify-content: center; }
.k-car-arrow { font-size: 26px; color: rgb(200, 255, 61); padding: 0 18px; }
.k-car-value { width: 240px; font-size: 72px; -unity-text-align: middle-center; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-car-count { font-size: 12px; color: rgba(255, 255, 255, 0.5); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }

/* ---------- career settings ---------- */
.k-cr-settings { width: 900px; align-self: center; margin-top: 120px; }
