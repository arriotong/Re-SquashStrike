.gd-plate { margin-top: 14px; width: 420px; }
.gd-reveal { flex-direction: row; flex-wrap: wrap; width: 1500px; }
.gd-reveal--one { width: 340px; }
.gd-card { width: 270px; height: 290px; margin: 0 16px 16px 0; padding: 14px; border-radius: 12px; border-top-width: 6px; background-color: rgba(14, 16, 22, 0.94); transition-property: opacity, scale; transition-duration: 0.22s; }
.gd-card--hidden { opacity: 0; scale: 0.85 0.85; }
.gd-card--big { background-color: rgba(40, 26, 56, 0.96); }
.gd-card-k { font-size: 11px; letter-spacing: 2px; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.gd-card-name { font-size: 26px; margin-top: 4px; white-space: normal; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.gd-card-slot { font-size: 12px; color: rgba(255, 255, 255, 0.6); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }
.gd-card-tag { position: absolute; right: 14px; bottom: 12px; font-size: 13px; color: rgba(255, 255, 255, 0.6); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.gd-card-tag--new { color: rgb(200, 255, 61); }

/* P2-M8 online */
.hud-net {
    position: absolute; right: 20px; top: 20px; padding: 4px 12px; border-radius: 6px;
    font-size: 13px; letter-spacing: 2px; color: rgba(255, 255, 255, 0.8); background-color: rgba(12, 13, 16, 0.80);
    -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold");
}
