.k-lk-rarity { font-size: 12px; letter-spacing: 2px; margin: 2px 0 6px 0; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }

/* ---- P4: Gear Drops ---- */
.gd-page { flex-direction: row; align-items: flex-start; }
.gd-shop { flex-direction: column; }
.gd-banner { width: 980px; margin-right: 20px; }
.gd-blurb { font-size: 16px; margin-bottom: 10px; white-space: normal; color: rgba(255, 255, 255, 0.8); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.gd-legends { flex-direction: row; margin: 6px 0 12px 0; }
.gd-legend { flex-direction: column; width: 300px; margin-right: 18px; padding: 12px; border-radius: 10px; background-color: rgba(255, 196, 64, 0.08); border-width: 1px; border-color: rgba(255, 196, 64, 0.45); }
.gd-legend-name { font-size: 24px; margin-top: 8px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.gd-legend-k { font-size: 10px; letter-spacing: 1px; color: rgb(255, 196, 64); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.gd-count { font-size: 18px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.gd-pity { font-size: 12px; margin: 4px 0 12px 0; color: rgba(255, 255, 255, 0.65); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }
.gd-acts { flex-direction: row; }
.gd-acts > .k-action { margin-right: 14px; }
.gd-odds { width: 520px; }
.gd-odd { flex-direction: row; align-items: center; margin: 3px 0; }
.gd-odd-dot { width: 12px; height: 12px; border-radius: 6px; margin-right: 10px; }
.gd-odd-name { flex-grow: 1; font-size: 16px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.gd-odd-pct { font-size: 14px; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.gd-rule { font-size: 11px; margin-top: 6px; white-space: normal; color: rgba(255, 255, 255, 0.6); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }
.gd-sw { width: 40px; height: 40px; border-radius: 6px; overflow: hidden; }
.gd-sw-big { width: 100%; height: 90px; border-radius: 8px; overflow: hidden; }
.gd-sw-card { position: absolute; left: 22%; right: 22%; top: 10%; height: 34%; border-radius: 10px; overflow: hidden; }
