.k-cr-goal--done { background-color: rgba(200, 255, 61, 0.10); }
.k-cr-goal--failed { opacity: 0.5; }
.k-cr-goal-mark { width: 34px; font-size: 26px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-cr-goal-name { font-size: 22px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-cr-goal-pay { font-size: 11px; color: rgba(255, 255, 255, 0.6); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }
.k-cr-sp-brand { font-size: 32px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-cr-sp-line { font-size: 14px; margin-top: 4px; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
