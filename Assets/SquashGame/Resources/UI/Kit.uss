/* ===========================================================
   re:SquashStrike UI kit (UI redesign U1) - the "feels like a game"
   components. Same identity as Theme.uss: lime #c8ff3d on charcoal,
   Rajdhani headings, JetBrains Mono numbers. Space first: a 96 px safe
   margin, 24-32 px between cards, one primary action bottom right.
   =========================================================== */

/* ---------- the screen ---------- */
.k-screen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; width: auto; padding: 0; background-image: none; }
.k-fade { position: absolute; left: 0; right: 0; bottom: 0; height: 70%; -unity-background-scale-mode: stretch-to-fill; }
.k-content { position: absolute; left: 96px; right: 96px; top: 168px; bottom: 120px; }
.k-page { flex-grow: 1; }

/* ---------- top bar ---------- */
.k-topbar { position: absolute; left: 96px; right: 96px; top: 44px; height: 96px; flex-direction: row; align-items: center; justify-content: space-between; }
.k-topbar-left { min-width: 360px; }
.k-topbar-left .fe-kicker { font-size: 13px; margin-bottom: 2px; }
.k-topbar-left .fe-title { font-size: 44px; margin-bottom: 0; }

/* ---------- tabs ---------- */
.k-tabs { flex-direction: row; align-items: center; }
.k-tab {
    font-size: 24px; letter-spacing: 3px; margin: 0 18px; padding: 6px 2px;
    color: rgba(255, 255, 255, 0.5); border-bottom-width: 3px; border-bottom-color: rgba(0, 0, 0, 0);
    -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold");
    transition-property: color, border-bottom-color; transition-duration: 0.15s;
}
.k-tab--on { color: rgb(255, 255, 255); border-bottom-color: rgb(200, 255, 61); }
.k-tab-glyph {
    font-size: 11px; color: rgba(255, 255, 255, 0.55); padding: 2px 7px; border-width: 1px; border-color: rgba(255, 255, 255, 0.18); border-radius: 4px;
    -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold");
}

/* ---------- the player chip ---------- */
.k-chip {
    flex-direction: row; align-items: center; padding: 6px 18px 6px 8px; border-radius: 40px;
    background-color: rgba(16, 18, 22, 0.88); border-width: 1px; border-color: rgba(255, 255, 255, 0.09); border-left-width: 4px;
}
.k-chip-ringbox { width: 48px; height: 48px; margin-right: 12px; justify-content: center; align-items: center; }
.k-ring { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.k-chip-level { font-size: 19px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-chip-title { font-size: 10px; letter-spacing: 2px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-chip-name { font-size: 20px; margin-top: -2px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-chip-next { font-size: 9px; letter-spacing: 1px; margin-top: 1px; color: rgba(255, 255, 255, 0.55); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }

/* ---------- cards ---------- */
.k-row { flex-direction: row; align-items: flex-end; justify-content: flex-start; flex-grow: 1; }
.k-card {
    position: relative; overflow: hidden; margin-right: 26px; border-radius: 14px;
    background-color: rgb(21, 23, 28); border-width: 1px; border-color: rgba(255, 255, 255, 0.09);
    transition-property: scale, border-color, translate; transition-duration: 0.14s;
}
.k-card--s { width: 240px; height: 200px; }
.k-card--m { width: 300px; height: 330px; }
.k-card--l { width: 400px; height: 360px; }
.k-card--hero { width: 520px; height: 400px; }
.k-card.fe-item--focused {
    scale: 1.04 1.04; translate: 0 -6px; border-width: 2px; border-color: rgb(200, 255, 61);
}
.k-card-art { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: scale-and-crop; justify-content: center; align-items: center; }
.k-card-shade { position: absolute; left: 0; right: 0; bottom: 0; height: 58%; background-color: rgba(8, 9, 11, 0.78); }
.k-card--live .k-card-shade { height: 42%; background-color: rgba(8, 9, 11, 0.82); }
.k-card-body { position: absolute; left: 22px; right: 22px; bottom: 20px; }
.k-card-kicker { font-size: 11px; letter-spacing: 3px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-card-title { font-size: 32px; margin: -2px 0 0 0; white-space: normal; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-card--hero .k-card-title { font-size: 46px; }
.k-card--s .k-card-title { font-size: 24px; }
.k-card-line { font-size: 12px; margin-top: 4px; color: rgba(255, 255, 255, 0.78); white-space: normal; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }
.k-card-lock { font-size: 11px; margin-top: 6px; color: rgba(255, 255, 255, 0.7); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-card--locked .k-card-art { opacity: 0.35; }
.k-card--locked .k-card-title { color: rgba(255, 255, 255, 0.55); }
.k-card-glyph { font-size: 120px; color: rgba(200, 255, 61, 0.85); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-badge {
    position: absolute; top: 14px; right: 14px; padding: 3px 10px; border-radius: 20px;
    background-color: rgba(14, 15, 18, 0.88); border-width: 1px; border-color: rgba(200, 255, 61, 0.45);
    font-size: 12px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold");
}
.k-badge--lime { background-color: rgb(200, 255, 61); color: rgb(14, 15, 18); border-width: 0; }
.k-new {
    position: absolute; top: 14px; left: 14px; padding: 3px 9px; border-radius: 4px; background-color: rgb(255, 74, 64);
    font-size: 11px; letter-spacing: 2px; color: rgb(255, 255, 255); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold");
}


/* ---------- the primary action ---------- */
.k-primary {
    position: absolute; right: 96px; bottom: 42px; padding: 12px 34px; border-radius: 6px;
    background-color: rgb(200, 255, 61); border-width: 0;
    transition-property: scale; transition-duration: 0.12s;
}
.k-primary.fe-item--focused { scale: 1.07 1.07; border-width: 3px; border-color: rgb(255, 255, 255); }
.k-primary-label { font-size: 28px; letter-spacing: 3px; color: rgb(14, 15, 18); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }

/* ---------- prompts ---------- */
.k-prompts { position: absolute; left: 96px; bottom: 52px; flex-direction: row; align-items: center; }
.k-prompt { flex-direction: row; align-items: center; margin-right: 26px; }
.k-glyph {
    min-width: 24px; height: 24px; padding: 0 6px; border-radius: 12px; margin-right: 8px; -unity-text-align: middle-center;
    font-size: 12px; color: rgb(14, 15, 18); background-color: rgb(220, 222, 226); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold");
}
.k-glyph--key { border-radius: 4px; }
.k-glyph--a { background-color: rgb(111, 220, 75); }
.k-glyph--b { background-color: rgb(255, 90, 74); }
.k-glyph--x { background-color: rgb(74, 168, 255); }
.k-glyph--y { background-color: rgb(255, 207, 58); }
.k-prompt-text { font-size: 13px; color: rgba(255, 255, 255, 0.7); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }

/* ---------- selectors ---------- */
.k-sel { flex-direction: row; align-items: center; height: 62px; padding: 0 18px; margin-bottom: 10px; border-radius: 10px; background-color: rgba(255, 255, 255, 0.04); border-width: 1px; border-color: rgba(255, 255, 255, 0.08); }
.k-sel.fe-item--focused { border-color: rgb(200, 255, 61); background-color: rgba(200, 255, 61, 0.08); }
.k-sel-label { width: 170px; font-size: 22px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-sel-strip { flex-direction: row; align-items: center; flex-grow: 1; }
.k-pill {
    padding: 6px 16px; margin-right: 8px; border-radius: 20px; font-size: 16px; color: rgba(255, 255, 255, 0.6);
    background-color: rgba(255, 255, 255, 0.05); border-width: 1px; border-color: rgba(255, 255, 255, 0.1);
    -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold");
}
.k-pill.k-on { color: rgb(14, 15, 18); background-color: rgb(200, 255, 61); border-color: rgb(200, 255, 61); }
.k-pip { width: 46px; height: 12px; margin-right: 6px; border-radius: 6px; background-color: rgba(255, 255, 255, 0.12); }
.k-pip.k-on, .k-pip.k-past { background-color: rgb(200, 255, 61); }
.k-sel-caption { font-size: 18px; margin-left: 12px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }

/* ---------- panels and grids ---------- */
.k-panel { padding: 18px 22px; margin: 0 20px 20px 0; border-radius: 14px; background-color: rgba(16, 18, 22, 0.88); border-width: 1px; border-color: rgba(255, 255, 255, 0.08); }
.k-panel-title { font-size: 11px; letter-spacing: 3px; color: rgb(200, 255, 61); margin-bottom: 12px; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-page { flex-direction: column; }
.k-grid3 { flex-direction: row; }
.k-grid3 > .k-panel { flex-grow: 1; flex-basis: 0; }
.k-grid2 { flex-direction: row; }
.k-grid2 > .k-panel { flex-grow: 1; }

/* ---------- tiers ---------- */
.k-tierrow { flex-direction: row; flex-wrap: wrap; }
.k-tieritem { align-items: center; width: 110px; margin: 0 6px 10px 0; }
.k-tier-name { font-size: 11px; margin-top: 6px; letter-spacing: 1px; color: rgba(255, 255, 255, 0.75); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }

/* ---------- stat bars ---------- */
.k-statbars { min-width: 420px; }
.k-sb-row { flex-direction: row; align-items: center; height: 30px; }
.k-sb-val { width: 52px; font-size: 18px; color: rgba(255, 255, 255, 0.75); -unity-text-align: middle-center; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-sb-val--win { color: rgb(200, 255, 61); }
.k-sb-bar { flex-grow: 1; height: 8px; border-radius: 4px; background-color: rgba(255, 255, 255, 0.07); flex-direction: row; }
.k-sb-bar--a { justify-content: flex-end; }
.k-sb-fill { height: 8px; border-radius: 4px; background-color: rgba(255, 255, 255, 0.35); }
.k-sb-fill--win { background-color: rgb(200, 255, 61); }
.k-sb-name { width: 130px; font-size: 11px; letter-spacing: 1px; color: rgba(255, 255, 255, 0.65); -unity-text-align: middle-center; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }

/* ---------- ranked table ---------- */
.k-tr { flex-direction: row; align-items: center; height: 34px; padding: 0 10px; border-bottom-width: 1px; border-bottom-color: rgba(255, 255, 255, 0.06); }
.k-tr--you { background-color: rgba(200, 255, 61, 0.14); border-radius: 6px; border-bottom-width: 0; }
.k-tr-pos { width: 40px; font-size: 15px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-tr-move { width: 40px; font-size: 11px; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-up { color: rgb(111, 220, 75); } .k-down { color: rgb(255, 74, 64); } .k-same { color: rgba(255, 255, 255, 0.35); }
.k-tr-name { flex-grow: 1; font-size: 18px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-tr-chip { width: 46px; font-size: 11px; color: rgba(255, 255, 255, 0.55); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }
.k-tr-bar { width: 110px; height: 6px; border-radius: 3px; background-color: rgba(255, 255, 255, 0.07); margin-right: 10px; }
.k-tr-fill { height: 6px; border-radius: 3px; background-color: rgba(200, 255, 61, 0.7); }
.k-tr-pts { width: 66px; font-size: 14px; -unity-text-align: middle-right; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }

/* ---------- the bracket ---------- */
.k-bracket { position: relative; }
.k-bracket-lines { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.k-bracket-col { position: absolute; top: 0; width: 200px; }
.k-bracket-head { font-size: 10px; letter-spacing: 2px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-bm {
    flex-direction: row; align-items: center; padding: 0 10px; border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.05); border-width: 1px; border-color: rgba(255, 255, 255, 0.12);
    transition-property: border-color, scale; transition-duration: 0.12s;
}
.k-bm--you { background-color: rgba(200, 255, 61, 0.12); border-color: rgba(200, 255, 61, 0.7); }
.k-bm.fe-item--focused { border-width: 2px; border-color: rgb(255, 255, 255); scale: 1.04 1.04; }
.k-bm-names { flex-grow: 1; flex-shrink: 1; overflow: hidden; }
.k-bm-name { font-size: 13px; height: 20px; -unity-text-align: middle-left; padding: 0; margin: 0; color: rgba(255, 255, 255, 0.55); overflow: hidden; white-space: nowrap; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }
.k-bm-name--won { color: rgb(255, 255, 255); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-bm-name--you { color: rgb(200, 255, 61); }
.k-bm-name--tbd { color: rgba(255, 255, 255, 0.25); }
.k-bm-score { font-size: 10px; color: rgb(200, 255, 61); -unity-text-align: middle-right; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }

/* ---------- timeline ---------- */
.k-timeline { position: relative; min-height: 70px; }
.k-tl-line { position: absolute; left: 4%; right: 4%; top: 10px; height: 2px; background-color: rgba(255, 255, 255, 0.12); }
.k-tl-row { flex-direction: row; justify-content: space-between; }
.k-tl-node { align-items: center; flex-grow: 1; flex-basis: 0; }
.k-tl-dot { width: 20px; height: 20px; border-radius: 10px; margin-bottom: 6px; background-color: rgb(29, 32, 38); border-width: 2px; border-color: rgba(255, 255, 255, 0.2); }
.k-tl-dot--done { background-color: rgb(200, 255, 61); border-color: rgb(200, 255, 61); }
.k-tl-dot--now { background-color: rgb(14, 15, 18); border-color: rgb(200, 255, 61); border-width: 4px; }
.k-tl-label { font-size: 11px; color: rgba(255, 255, 255, 0.6); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-tl-note { font-size: 13px; color: rgb(255, 255, 255); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }

/* ---------- count-up and stamps ---------- */
.k-count { font-size: 72px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-stamp {
    align-self: flex-start; margin-top: 10px; padding: 4px 16px; border-width: 4px; border-color: rgb(255, 184, 59); border-radius: 6px;
    font-size: 34px; letter-spacing: 4px; color: rgb(255, 184, 59); rotate: -6deg;
    -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold");
    transition-property: scale, opacity; transition-duration: 0.18s; transition-timing-function: ease-out-back;
}
.k-stamp--in { scale: 2.2 2.2; opacity: 0; }

/* ---------- screen transitions ---------- */
.fe-screen { transition-property: opacity, translate, scale; transition-duration: 0.18s; transition-timing-function: ease-out-cubic; }
.fe-in-right { translate: 60px 0; opacity: 0; }
.fe-in-left { translate: -60px 0; opacity: 0; }
.fe-in-fade { opacity: 0; scale: 0.96 0.96; }

/* ================= U2: the hub, versus, pause, full time ================= */

/* ---------- action rows ---------- */
.k-action {
    flex-direction: row; align-items: center; justify-content: space-between; height: 58px; padding: 0 22px; margin-bottom: 10px;
    border-radius: 10px; background-color: rgba(255, 255, 255, 0.05); border-width: 1px; border-color: rgba(255, 255, 255, 0.09);
    transition-property: background-color, translate; transition-duration: 0.12s;
}
.k-action.fe-item--focused { background-color: rgb(200, 255, 61); border-color: rgb(200, 255, 61); translate: 6px 0; }
.k-action-label { font-size: 24px; letter-spacing: 1px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-action.fe-item--focused .k-action-label, .k-action.fe-item--focused .k-action-glyph { color: rgb(14, 15, 18); }
.k-action-glyph { font-size: 14px; color: rgba(255, 255, 255, 0.5); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-action--danger .k-action-label { color: rgb(255, 74, 64); }
.k-action--danger.fe-item--focused { background-color: rgb(255, 74, 64); border-color: rgb(255, 74, 64); }
.k-action--danger.fe-item--focused .k-action-label { color: rgb(14, 15, 18); }
/* the settings chip in the hub's top bar */
.k-action--chip { height: 44px; margin: 0 16px 0 auto; padding: 0 16px; border-radius: 22px; background-color: rgba(16, 18, 22, 0.88); }
.k-action--chip .k-action-label { font-size: 18px; margin-right: 10px; }
.k-action--chip .k-action-glyph { padding: 1px 7px; border-radius: 10px; background-color: rgb(255, 207, 58); color: rgb(14, 15, 18); }

/* ---------- versus ---------- */
.k-versus { flex-direction: row; flex-grow: 1; align-items: stretch; justify-content: space-between; }
.k-vs-side { width: 460px; align-items: flex-start; }
.k-vs-pic {
    width: 460px; height: 560px; border-radius: 16px; margin-bottom: 14px; overflow: hidden;
    border-width: 2px; border-color: rgba(255, 255, 255, 0.10); -unity-background-scale-mode: scale-and-crop; background-color: rgb(21, 23, 28);
}
.k-vs-kicker { font-size: 12px; letter-spacing: 3px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-vs-name { font-size: 54px; margin-top: -6px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-vs-meta { font-size: 13px; letter-spacing: 1px; color: rgba(255, 255, 255, 0.75); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-vs-lines { font-size: 13px; margin-top: 10px; color: rgba(255, 255, 255, 0.7); white-space: normal; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }
.k-vs-mid { width: 680px; justify-content: center; }
.k-vs-vs {
    font-size: 110px; align-self: center; margin-bottom: 20px; color: rgb(200, 255, 61);
    -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); text-shadow: 0 0 30px rgba(200, 255, 61, 0.6);
}
.k-vs-mid .k-sel-label { width: 140px; }

/* ---------- pause: a side panel ---------- */
.k-side {
    position: absolute; left: auto; right: 0; top: 0; bottom: 0; width: 600px;
    padding: 72px 64px 48px 64px; background-color: rgba(12, 13, 16, 0.96); border-left-width: 4px; border-left-color: rgb(200, 255, 61);
}
.k-side .fe-title { font-size: 56px; margin-bottom: 18px; }
.k-side-score { margin-bottom: 10px; padding: 10px 14px; border-radius: 10px; background-color: rgba(255, 255, 255, 0.04); }
.k-side-row { flex-direction: row; align-items: center; height: 40px; }
.k-side-serve { width: 20px; font-size: 12px; color: rgb(200, 255, 61); }
.k-side-name { flex-grow: 1; font-size: 22px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-side-games { width: 36px; font-size: 18px; color: rgba(255, 255, 255, 0.6); -unity-text-align: middle-center; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-side-points { width: 54px; font-size: 30px; color: rgb(200, 255, 61); -unity-text-align: middle-right; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-side-stats { font-size: 12px; color: rgba(255, 255, 255, 0.6); margin-bottom: 26px; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }
.k-prompts--side { left: 64px; bottom: 40px; }

/* ---------- full time ---------- */
.k-fulltime { position: absolute; left: 0; top: 0; right: 0; bottom: 0; width: auto; padding: 56px 96px 120px 96px; align-items: center; }
.k-fulltime .fe-kicker { font-size: 15px; letter-spacing: 6px; -unity-text-align: middle-center; }
.k-fulltime .fe-title {
    font-size: 96px; margin: -10px 0 0 0; color: rgb(200, 255, 61); -unity-text-align: middle-center;
    text-shadow: 0 0 30px rgba(200, 255, 61, 0.5);
}
.k-fulltime > VisualElement { align-self: stretch; }
.k-ft-head { flex-direction: row; justify-content: center; align-items: center; margin-top: -4px; }
.k-ft-name { width: 420px; font-size: 26px; -unity-text-align: middle-center; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-ft-games { font-size: 54px; margin: 0 30px; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-ft-chips { flex-direction: row; justify-content: center; margin: 8px 0 22px 0; }
.k-ft-chip { margin: 0 6px; padding: 3px 12px; border-radius: 14px; font-size: 14px; color: rgba(255, 255, 255, 0.7); background-color: rgba(255, 255, 255, 0.07); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-ft-chip--won { color: rgb(14, 15, 18); background-color: rgb(200, 255, 61); }
.k-ft-cols { flex-direction: row; justify-content: center; }
.k-ft-cols > .k-panel { width: 760px; }
.k-ft-right { width: 760px; }
.k-ft-highs { flex-direction: row; justify-content: space-around; }
.k-ft-high { align-items: center; }
.k-ft-high-v { font-size: 52px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-ft-high-n { font-size: 11px; letter-spacing: 2px; color: rgba(255, 255, 255, 0.6); margin-top: -6px; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-ft-more { position: absolute; left: 96px; bottom: 40px; flex-direction: row; }
.k-ft-more > .k-action { width: 280px; margin-right: 16px; margin-bottom: 0; }

/* ================= U3: the career ================= */
.k-cr-head { font-size: 12px; letter-spacing: 3px; color: rgb(200, 255, 61); margin-bottom: 12px; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-cr-note { font-size: 12px; margin-top: 10px; color: rgba(255, 255, 255, 0.6); white-space: normal; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }
.k-cr-empty { font-size: 13px; color: rgba(255, 255, 255, 0.55); white-space: normal; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }
.k-up { color: rgb(200, 255, 61); }
.k-down { color: rgb(255, 90, 74); }
.k-same { color: rgba(255, 255, 255, 0.4); }
.k-stamp--plain { border-color: rgb(255, 255, 255); color: rgb(255, 255, 255); }

/* ---------- central ---------- */
.k-cr-top { flex-direction: row; height: 450px; }
.k-cr-hero { flex-grow: 1; margin-right: 24px; }
.k-cr-hero > .k-row { align-items: flex-start; }
.k-card--match { width: 640px; height: 390px; }
.k-card--event { width: 270px; height: 390px; margin-right: 20px; }
.k-card--event .k-card-title { font-size: 28px; }
.k-cr-cardtier { position: absolute; left: 18px; top: 18px; }
.k-cr-rankw { width: 470px; margin: 0; }
.k-cr-rank-row { flex-direction: row; align-items: flex-end; }
.k-cr-rank-big { font-size: 84px; margin: -14px 0 -8px 0; color: rgb(255, 255, 255); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-cr-rank-move { font-size: 20px; margin: 0 0 14px 14px; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-cr-rank-sub { font-size: 12px; letter-spacing: 1px; color: rgba(255, 255, 255, 0.65); margin-bottom: 10px; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-cr-rankw .k-tr-bar { width: 70px; }
.k-cr-bottom { flex-direction: row; margin-top: 24px; align-items: flex-start; }
.k-cr-bottom > .k-panel { margin: 0 24px 0 0; }
.k-cr-news { flex-grow: 1.4; flex-basis: 0; }
.k-cr-season { flex-grow: 1; flex-basis: 0; margin-right: 0; }
.k-cr-news-row { flex-direction: row; }
.k-cr-news-item { flex-grow: 1; flex-basis: 0; margin-right: 18px; padding: 4px 0 4px 14px; border-left-width: 3px; border-left-color: rgba(200, 255, 61, 0.7); }
.k-cr-news-k { font-size: 10px; letter-spacing: 2px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-cr-news-t { font-size: 20px; margin-top: 4px; white-space: normal; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }

/* ---------- calendar ---------- */
.k-cr-cal { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.k-cr-month {
    width: 272px; height: 372px; margin-bottom: 20px; padding: 16px 16px; border-radius: 12px;
    background-color: rgba(16, 18, 22, 0.88); border-width: 1px; border-color: rgba(255, 255, 255, 0.08);
}
.k-cr-month--past { opacity: 0.6; }
.k-cr-month--now { border-width: 2px; border-color: rgb(200, 255, 61); background-color: rgba(24, 30, 18, 0.92); }
.k-cr-month-head { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 14px; }
.k-cr-month-name { font-size: 30px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-cr-now { padding: 2px 8px; border-radius: 10px; font-size: 10px; letter-spacing: 2px; color: rgb(14, 15, 18); background-color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-cr-ev { flex-direction: row; align-items: center; height: 30px; }
.k-cr-ev-name { font-size: 16px; margin-left: 10px; color: rgba(255, 255, 255, 0.85); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-cr-mine {
    position: absolute; left: 16px; right: 16px; bottom: 16px; padding: 6px 10px; border-radius: 6px; white-space: normal;
    font-size: 12px; color: rgb(255, 255, 255); background-color: rgba(255, 255, 255, 0.08); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold");
}
.k-cr-mine--won { color: rgb(14, 15, 18); background-color: rgb(255, 184, 59); }

/* ---------- rankings ---------- */
.k-cr-rgrid { flex-direction: row; flex-grow: 1; }
.k-cr-tablep { flex-grow: 1; margin-bottom: 0; }
.k-cr-tablep .k-tr-bar { width: 260px; }
.k-cr-tablebox { margin-top: 4px; }
.k-cr-ladder { width: 520px; margin: 0; }
.k-cr-lad { flex-direction: row; align-items: center; height: 50px; padding: 0 14px; margin-bottom: 4px; border-radius: 10px; background-color: rgba(255, 255, 255, 0.03); opacity: 0.55; }
.k-cr-lad--open { opacity: 1; background-color: rgba(200, 255, 61, 0.06); }
.k-cr-lad-text { flex-grow: 1; margin-left: 16px; }
.k-cr-lad-name { font-size: 19px; margin: 0; padding: 0; -unity-text-align: lower-left; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-cr-lad-line { font-size: 10px; margin: 0; padding: 0; color: rgba(255, 255, 255, 0.6); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }
.k-cr-lad-gate { font-size: 14px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }

/* ---------- player ---------- */
.k-cr-pgrid { flex-direction: row; flex-grow: 1; }
.k-cr-pgrid > .k-panel, .k-cr-pmid > .k-panel { margin: 0 24px 24px 0; }
.k-cr-pcard { width: 420px; margin-bottom: 0; }
.k-cr-ppic { width: 376px; height: 470px; border-radius: 10px; margin-bottom: 14px; -unity-background-scale-mode: scale-and-crop; background-color: rgb(21, 23, 28); }
.k-cr-pname { font-size: 44px; margin-top: -6px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-cr-pmeta { font-size: 12px; letter-spacing: 1px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-cr-pmid { flex-grow: 1; flex-basis: 0; }
.k-cr-bytier { flex-direction: row; flex-wrap: wrap; margin-top: 14px; }
.k-cr-bytier-item { flex-direction: row; align-items: center; width: 33%; height: 30px; }
.k-cr-bytier-n { font-size: 15px; margin-left: 8px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-cr-rival { flex-direction: row; align-items: center; height: 36px; }
.k-cr-rival-star { width: 24px; color: rgb(255, 184, 59); font-size: 16px; }
.k-cr-rival-name { flex-grow: 1; font-size: 20px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-cr-rival-h2h { font-size: 13px; color: rgba(255, 255, 255, 0.7); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-cr-hist { flex-grow: 1; flex-basis: 0; margin-right: 0; margin-bottom: 0; }
.k-cr-hrow { flex-direction: row; align-items: center; height: 58px; border-bottom-width: 1px; border-bottom-color: rgba(255, 255, 255, 0.06); }
.k-cr-hmid { flex-grow: 1; margin-left: 12px; }
.k-cr-hname { font-size: 18px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-cr-hline { font-size: 10px; color: rgba(255, 255, 255, 0.55); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }
.k-cr-hscore { font-size: 12px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }

/* ---------- chips and tiles ---------- */
.k-cr-form { flex-direction: row; }
.k-cr-form-none { font-size: 11px; color: rgba(255, 255, 255, 0.45); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }
.k-cr-chip {
    min-width: 30px; height: 24px; padding: 0 6px; margin: 0 3px; border-radius: 5px; -unity-text-align: middle-center;
    font-size: 11px; color: rgba(255, 255, 255, 0.7); background-color: rgba(255, 255, 255, 0.08); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold");
}
.k-cr-chip--w { color: rgb(14, 15, 18); background-color: rgb(200, 255, 61); }
.k-cr-chip--f { color: rgb(14, 15, 18); background-color: rgb(255, 184, 59); }
.k-cr-tiles { flex-direction: row; justify-content: center; }
.k-cr-tile { min-width: 220px; align-items: center; margin: 0 14px; padding: 14px 18px; border-radius: 12px; background-color: rgba(16, 18, 22, 0.88); border-width: 1px; border-color: rgba(255, 255, 255, 0.08); }
.k-cr-tile-v { font-size: 52px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-cr-tile-n { font-size: 11px; letter-spacing: 2px; color: rgba(255, 255, 255, 0.6); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-cr-tile-move { font-size: 12px; margin-top: 4px; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-cr-pmid .k-cr-tile { min-width: 0; flex-grow: 1; margin: 0 6px; }
.k-cr-pmid .k-cr-tile-v { font-size: 38px; }

/* ---------- match preview ---------- */
.k-vs-side--right { align-items: flex-end; }
.k-vs-side--right .k-vs-name, .k-vs-side--right .k-vs-meta { -unity-text-align: upper-right; }
.k-cr-pv-event { flex-direction: row; align-items: center; justify-content: center; margin-bottom: 14px; }
.k-cr-pv-round { font-size: 14px; letter-spacing: 3px; margin-left: 12px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-cr-tape-row { flex-direction: row; align-items: center; height: 46px; border-bottom-width: 1px; border-bottom-color: rgba(255, 255, 255, 0.06); }
.k-cr-tape-a { flex-grow: 1; flex-basis: 0; flex-direction: row; justify-content: flex-start; }
.k-cr-tape-b { flex-grow: 1; flex-basis: 0; flex-direction: row; justify-content: flex-end; }
.k-cr-tape-n { width: 200px; font-size: 11px; letter-spacing: 2px; -unity-text-align: middle-center; color: rgba(255, 255, 255, 0.55); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-cr-tape-v { font-size: 24px; color: rgba(255, 255, 255, 0.8); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-cr-tape-v--win { color: rgb(200, 255, 61); }
.k-cr-pv-acts { flex-direction: row; justify-content: center; margin-top: 16px; }
.k-cr-pv-acts > .k-action { width: 240px; margin: 0 8px; }
.k-cr-callout {
    align-self: flex-end; max-width: 460px; margin-top: 8px; padding: 6px 12px; border-radius: 6px; white-space: normal; -unity-text-align: middle-right;
    font-size: 13px; color: rgb(255, 255, 255); background-color: rgba(16, 18, 22, 0.88); border-right-width: 3px; border-right-color: rgb(200, 255, 61);
    -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium");
}
.k-cr-rivalkick { color: rgb(255, 184, 59); }

/* ---------- the draw ---------- */
.k-cr-draw { flex-direction: row; flex-grow: 1; }
.k-cr-draw-scroll { flex-grow: 1; margin-right: 24px; border-radius: 14px; background-color: rgba(12, 13, 16, 0.9); border-width: 1px; border-color: rgba(255, 255, 255, 0.08); }
.k-cr-draw-scroll .unity-scroll-view__content-container { padding: 22px 22px 22px 22px; }
.k-cr-draw .k-bm { background-color: rgba(28, 31, 38, 0.95); }
.k-cr-draw .k-bm--you { background-color: rgba(52, 66, 24, 0.95); }
.k-cr-draw-detail { width: 400px; margin: 0; }
.k-cr-champ { position: absolute; width: 200px; padding: 10px 14px; border-radius: 10px; border-width: 2px; border-color: rgb(255, 184, 59); background-color: rgba(30, 24, 12, 0.92); }
.k-cr-champ-k { font-size: 10px; letter-spacing: 3px; color: rgb(255, 184, 59); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-cr-champ-n { font-size: 22px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-cr-champ-n--you { color: rgb(200, 255, 61); }
.k-cr-dt-player { padding: 10px 14px; border-radius: 10px; background-color: rgba(255, 255, 255, 0.04); border-left-width: 3px; border-left-color: rgba(255, 255, 255, 0.15); }
.k-cr-dt-player--won { border-left-color: rgb(255, 255, 255); background-color: rgba(255, 255, 255, 0.08); }
.k-cr-dt-player--you { border-left-color: rgb(200, 255, 61); }
.k-cr-dt-name { font-size: 28px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-cr-dt-meta { font-size: 11px; letter-spacing: 1px; color: rgba(255, 255, 255, 0.6); white-space: normal; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-cr-dt-v { font-size: 18px; margin: 6px 0; -unity-text-align: middle-center; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-cr-dt-chips { flex-direction: row; margin: 16px 0 6px 0; }
.k-cr-dt-chips > .k-ft-chip { margin: 0 8px 0 0; }
.k-cr-dt-h2h { font-size: 12px; margin-top: 12px; color: rgba(255, 255, 255, 0.75); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }

/* ---------- results ---------- */
.k-cr-result { flex-grow: 1; align-items: center; justify-content: center; }
.k-cr-result--card { flex-grow: 0; align-self: center; width: 760px; margin-top: 110px; padding: 40px 40px 34px 40px; border-radius: 16px; background-color: rgba(12, 13, 16, 0.9); border-width: 1px; border-color: rgba(255, 255, 255, 0.08); }
.k-cr-result > .k-stamp { align-self: center; font-size: 72px; margin: 0 0 18px 0; }
.k-cr-preview .k-vs-pic { height: 470px; }
.k-cr-res-head { flex-direction: row; align-items: center; margin-bottom: 14px; }
.k-cr-res-head > .k-tier { margin-right: 22px; }
.k-cr-res-head > .k-stamp { align-self: center; margin-top: 0; font-size: 64px; }
.k-cr-res-k { font-size: 13px; letter-spacing: 3px; margin-right: 22px; color: rgba(255, 255, 255, 0.65); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-cr-res-v { font-size: 26px; margin: 10px 0 18px 0; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-cr-result > .k-cr-tiles { margin-bottom: 22px; }
.k-cr-result > .rw { width: 1000px; }
.k-cr-res-year { width: 1000px; margin: 8px 0 0 0; }

/* ---------- create a player ---------- */
.k-cr-create { flex-direction: row; flex-grow: 1; align-items: flex-start; }
.k-cr-steps { flex-grow: 1; margin-left: 40px; padding: 30px 40px 36px 40px; border-radius: 16px; background-color: rgba(12, 13, 16, 0.88); border-width: 1px; border-color: rgba(255, 255, 255, 0.08); }
.k-cr-dots { flex-direction: row; margin-bottom: 36px; }
.k-cr-dot {
    padding: 6px 16px; margin-right: 12px; border-radius: 16px; font-size: 13px; letter-spacing: 2px;
    color: rgba(255, 255, 255, 0.45); background-color: rgba(255, 255, 255, 0.05); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold");
}
.k-cr-dot--done { color: rgb(200, 255, 61); }
.k-cr-dot--on { color: rgb(14, 15, 18); background-color: rgb(200, 255, 61); }
.k-cr-step-q { font-size: 64px; margin-bottom: 24px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-cr-step-hint { font-size: 13px; margin-top: 18px; max-width: 760px; color: rgba(255, 255, 255, 0.6); white-space: normal; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }
.k-cr-name { width: 760px; flex-direction: row; align-items: center; height: 76px; padding: 0 18px; border-radius: 10px; background-color: rgba(255, 255, 255, 0.04); border-width: 1px; border-color: rgba(255, 255, 255, 0.08); }
.k-cr-name.fe-item--focused { border-color: rgb(200, 255, 61); background-color: rgba(200, 255, 61, 0.08); }
.k-cr-name .fe-item__label { width: 140px; font-size: 22px; }
.k-cr-name .fe-text { flex-grow: 1; }
.k-cr-step > .k-sel { width: 760px; }
.k-cr-summary { margin-top: 48px; font-size: 14px; letter-spacing: 2px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-carousel { flex-direction: row; align-items: center; width: 760px; height: 110px; padding: 0 18px; border-radius: 10px; background-color: rgba(255, 255, 255, 0.04); border-width: 1px; border-color: rgba(255, 255, 255, 0.08); }
.k-carousel.fe-item--focused { border-color: rgb(200, 255, 61); background-color: rgba(200, 255, 61, 0.08); }
.k-car-strip { flex-direction: row; align-items: center; flex-grow: 1; justify-content: center; }
.k-car-arrow { font-size: 26px; color: rgb(200, 255, 61); padding: 0 18px; }
.k-car-value { width: 240px; font-size: 72px; -unity-text-align: middle-center; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-car-count { font-size: 12px; color: rgba(255, 255, 255, 0.5); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }

/* ---------- career settings ---------- */
.k-cr-settings { width: 900px; align-self: center; margin-top: 120px; }

/* ================= U4: arcade, practice, academy ================= */
.k-stamp--good { border-color: rgb(200, 255, 61); color: rgb(200, 255, 61); }
.k-stamp--bad { border-color: rgb(255, 90, 74); color: rgb(255, 90, 74); }

/* ---------- target arcade ---------- */
.k-ta-head { flex-direction: row; align-items: flex-end; margin-bottom: 26px; }
.k-ta-total { font-size: 40px; margin-right: 22px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-ta-sub { font-size: 14px; margin-bottom: 8px; color: rgba(255, 255, 255, 0.75); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }
.k-ta-cabs { align-items: flex-start; }
.k-card--cab { width: 262px; height: 540px; margin-right: 18px; }
.k-card--cab .k-card-title { font-size: 30px; }
.k-card--cab .k-card-shade { height: 50%; }
.k-ta-levels { flex-direction: row; margin-top: 22px; }
.k-ta-levels > .k-row { align-items: flex-start; flex-grow: 0; }
.k-card--level { width: 400px; height: 440px; }
.k-card--level .k-card-title { font-size: 44px; }
.k-ta-detail { width: 430px; margin: 0; }
.k-ta-thr-row { flex-direction: row; margin-bottom: 18px; }
.k-ta-thr { flex-grow: 1; flex-basis: 0; align-items: center; margin-right: 8px; padding: 10px 0; border-radius: 10px; background-color: rgba(255, 255, 255, 0.04); border-width: 1px; border-color: rgba(255, 255, 255, 0.08); }
.k-ta-thr--on { background-color: rgba(200, 255, 61, 0.12); border-color: rgb(200, 255, 61); }
.k-ta-thr-s { font-size: 16px; color: rgba(255, 255, 255, 0.4); }
.k-ta-thr--on .k-ta-thr-s { color: rgb(200, 255, 61); }
.k-ta-thr-v { font-size: 24px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-ta-bestrow { flex-direction: row; align-items: flex-end; justify-content: space-between; margin-bottom: 10px; }
.k-ta-best-k { font-size: 11px; letter-spacing: 2px; margin-bottom: 8px; color: rgba(255, 255, 255, 0.6); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-ta-best-v { font-size: 44px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-ta-best-none { font-size: 13px; margin-bottom: 8px; color: rgba(255, 255, 255, 0.55); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-ta-next-k { font-size: 12px; margin: 6px 0 6px 0; color: rgba(255, 255, 255, 0.75); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-ta-bar { height: 10px; border-radius: 5px; background-color: rgba(255, 255, 255, 0.08); }
.k-ta-bar-fill { height: 10px; border-radius: 5px; background-color: rgb(200, 255, 61); }

/* results */
.k-ta-res-top { align-items: center; }
.k-ta-res-k { font-size: 13px; letter-spacing: 4px; color: rgba(255, 255, 255, 0.65); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-ta-score { font-size: 120px; margin: -20px 0 -14px 0; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); text-shadow: 0 0 30px rgba(200, 255, 61, 0.45); }
.k-ta-stars { flex-direction: row; align-items: center; margin-bottom: 6px; }
.k-ta-star {
    font-size: 84px; margin: 0 6px; color: rgba(255, 255, 255, 0.14);
    transition-property: scale, color; transition-duration: 0.2s; transition-timing-function: ease-out-back;
}
.k-ta-star--on { color: rgb(255, 207, 58); scale: 1.12 1.12; }
.k-ta-stars > .k-stamp { align-self: center; margin: 0 0 0 26px; }
.k-ta-res-best { font-size: 16px; margin-bottom: 14px; color: rgba(255, 255, 255, 0.7); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-ta-nextbox { width: 700px; margin: 6px 0 14px 0; }

/* practice */
.k-ta-free { flex-direction: row; align-items: flex-start; }
.k-card--free { width: 800px; height: 560px; }
.k-ta-traypanel { flex-grow: 1; margin: 0 0 0 10px; }
.k-ta-trayrow { flex-direction: row; padding: 12px 0; border-bottom-width: 1px; border-bottom-color: rgba(255, 255, 255, 0.06); }
.k-ta-tray-k { width: 150px; font-size: 11px; letter-spacing: 2px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-ta-tray-v { flex-shrink: 1; font-size: 17px; white-space: normal; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-ta-drills { align-items: flex-start; }
.k-card--drill { width: 316px; height: 540px; margin-right: 20px; }

/* the coach tray: the right edge, the court in view */
.k-tray {
    position: absolute; left: auto; right: 0; top: 0; bottom: 0; width: 640px;
    padding: 48px 44px 48px 44px; background-color: rgba(12, 13, 16, 0.95); border-left-width: 4px; border-left-color: rgb(200, 255, 61);
}
.k-tray .fe-title { font-size: 46px; margin-bottom: 14px; }
.k-tray .k-sel { height: 52px; margin-bottom: 8px; padding: 0 14px; }
.k-tray .k-sel-label { width: 112px; font-size: 18px; }
.k-tray .k-pill { font-size: 14px; padding: 4px 10px; margin-right: 6px; }
.k-tray .k-carousel { width: auto; height: 76px; margin-bottom: 8px; padding: 0 14px; }
.k-tray .k-car-value { width: 220px; font-size: 36px; }
.k-tray .k-action { height: 50px; margin: 8px 0 0 0; }
.k-tray .k-prompts--side { left: 44px; bottom: 26px; }

/* ---------- academy: the trail ---------- */
.k-ac-stage { flex-direction: row; flex-grow: 1; }
.k-ac-left { flex-grow: 1; margin-right: 24px; }
.k-ac-chapter { margin: 0 0 24px 0; height: 330px; }
.k-trail { position: relative; height: 250px; margin: 6px 20px 0 20px; }
.k-node, .k-node.fe-item--focused { align-items: center; background-color: rgba(0, 0, 0, 0); border-width: 0; }
.k-node-dot {
    width: 64px; height: 64px; border-radius: 32px; -unity-text-align: middle-center; font-size: 26px;
    color: rgba(255, 255, 255, 0.55); background-color: rgb(24, 26, 32); border-width: 3px; border-color: rgba(255, 255, 255, 0.2);
    -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); transition-property: scale, border-color; transition-duration: 0.12s;
}
.k-node--done .k-node-dot { color: rgb(14, 15, 18); background-color: rgb(200, 255, 61); border-color: rgb(200, 255, 61); }
.k-node--next .k-node-dot { color: rgb(200, 255, 61); border-color: rgb(200, 255, 61); border-width: 5px; }
.k-node--just .k-node-dot { scale: 1.2 1.2; border-color: rgb(255, 255, 255); }
.k-node.fe-item--focused .k-node-dot { scale: 1.18 1.18; border-color: rgb(255, 255, 255); border-width: 4px; }
.k-node-title { margin-top: 8px; font-size: 16px; -unity-text-align: upper-center; white-space: normal; color: rgba(255, 255, 255, 0.8); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-node.fe-item--focused .k-node-title { color: rgb(255, 255, 255); }
.k-ac-card { width: 470px; margin: 0; }
.k-ac-title { font-size: 46px; margin-top: -6px; white-space: normal; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-ac-status { align-self: flex-start; margin: 6px 0 14px 0; padding: 3px 10px; border-radius: 10px; font-size: 11px; letter-spacing: 2px; color: rgb(200, 255, 61); border-width: 1px; border-color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-ac-status--done { color: rgb(14, 15, 18); background-color: rgb(200, 255, 61); }
.k-ac-blurb { font-size: 20px; margin-bottom: 16px; white-space: normal; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-ac-steps { margin-bottom: 10px; }
.k-ac-step { flex-direction: row; align-items: flex-start; margin-bottom: 10px; }
.k-ac-step-n { width: 26px; height: 26px; border-radius: 13px; margin-right: 12px; -unity-text-align: middle-center; font-size: 12px; color: rgb(14, 15, 18); background-color: rgba(255, 255, 255, 0.7); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-ac-step-t { flex-shrink: 1; font-size: 13px; white-space: normal; color: rgba(255, 255, 255, 0.85); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }
.k-ac-quiz { font-size: 12px; margin: 4px 0 12px 0; color: rgb(255, 207, 58); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-ac-keys { flex-direction: row; align-items: center; padding: 10px 12px; border-radius: 8px; background-color: rgba(255, 255, 255, 0.05); }
.k-ac-keys-k { font-size: 10px; letter-spacing: 2px; margin-right: 14px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-ac-keys-v { flex-shrink: 1; font-size: 12px; white-space: normal; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-ac-mini { width: 1180px; height: 280px; margin: 14px 0 14px 0; }
.k-ac-mini .k-trail { height: 200px; }
.k-ac-modepick { width: 1000px; margin: 0 0 14px 0; }
.k-cr-result > .k-stamp--good { font-size: 64px; }

/* ---------- the quiz: a panel at the bottom ---------- */
.k-quiz {
    position: absolute; left: 0; right: 0; top: auto; bottom: 0; width: auto; height: 400px;
    padding: 34px 96px 0 96px; background-color: rgba(10, 11, 14, 0.95); border-top-width: 4px; border-top-color: rgb(200, 255, 61);
}
.k-quiz .fe-kicker { font-size: 13px; }
.k-quiz .fe-title { font-size: 40px; margin-bottom: 20px; max-width: 1300px; white-space: normal; }
.k-quiz-count { position: absolute; right: 96px; top: 38px; font-size: 13px; letter-spacing: 2px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-quiz-answers { flex-direction: row; }
.k-card--answer { width: 440px; height: 150px; margin-right: 26px; }
.k-card--answer .k-card-shade { height: 100%; background-color: rgba(255, 255, 255, 0.03); }
.k-card--answer .k-card-title { font-size: 30px; }
.k-quiz-reveal { flex-direction: row; align-items: center; }
.k-quiz-reveal > .k-stamp { align-self: center; margin: 0 36px 0 0; font-size: 46px; }
.k-quiz-why { flex-grow: 1; flex-shrink: 1; margin-right: 36px; }
.k-quiz-call { font-size: 14px; letter-spacing: 2px; margin-bottom: 8px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-quiz-explain { flex-shrink: 1; font-size: 20px; white-space: normal; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-quiz-go { width: 260px; }
.k-prompts--quiz { left: 96px; bottom: 28px; }
.k-quiz .k-cr-pv-acts { justify-content: flex-start; margin-top: 22px; }
.k-quiz .k-cr-pv-acts > .k-action { width: 320px; margin: 0 16px 0 0; }

/* ================= U5: locker, stats, achievements, settings, HUD, toasts ================= */

/* ---------- the locker: rail | athlete | item ---------- */
.k-lk { flex-direction: row; flex-grow: 1; }
.k-lk-rail { width: 330px; margin-right: 24px; }
.k-slot {
    flex-direction: row; align-items: center; height: 60px; padding: 0 12px; margin-bottom: 6px; border-radius: 10px;
    background-color: rgba(16, 18, 22, 0.88); border-width: 1px; border-color: rgba(255, 255, 255, 0.07);
    transition-property: translate, background-color; transition-duration: 0.12s;
}
.k-slot.fe-item--focused { background-color: rgba(200, 255, 61, 0.14); border-color: rgb(200, 255, 61); translate: 8px 0; }
.k-slot-icon { width: 36px; height: 36px; margin-right: 14px; }
.k-slot-text { flex-grow: 1; flex-shrink: 1; }
.k-slot-name { font-size: 19px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-slot-value { font-size: 11px; color: rgba(255, 255, 255, 0.6); overflow: hidden; white-space: nowrap; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }
.k-slot-value--locked { color: rgba(255, 184, 59, 0.85); }
.k-slot.fe-item--focused .k-slot-value { color: rgb(255, 255, 255); }
.k-slot-new { padding: 2px 6px; border-radius: 4px; font-size: 9px; letter-spacing: 1px; color: rgb(255, 255, 255); background-color: rgb(255, 74, 64); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-lk-stage { flex-grow: 1; align-items: center; margin-right: 24px; }
.k-lk-pic {
    width: 640px; height: 610px; border-radius: 18px; overflow: hidden; -unity-background-scale-mode: scale-and-crop;
    background-color: rgb(21, 23, 28); border-width: 2px; border-color: rgba(255, 255, 255, 0.1);
}
.k-swatches { flex-direction: row; align-items: center; justify-content: center; margin-top: 18px; height: 110px; }
.k-sw {
    width: 64px; height: 64px; margin: 0 5px; border-radius: 10px; overflow: hidden; justify-content: center; align-items: center;
    border-width: 2px; border-color: rgba(255, 255, 255, 0.15); transition-property: scale; transition-duration: 0.12s;
}
.k-sw--on { scale: 1.3 1.3; border-width: 3px; border-color: rgb(200, 255, 61); margin: 0 18px; }
.k-sw--locked { opacity: 0.45; }
.k-sw--text { width: 104px; background-color: rgba(16, 18, 22, 0.92); }
.k-sw-b { position: absolute; left: 0; right: 0; bottom: 0; height: 30%; }
.k-sw-name { font-size: 11px; -unity-text-align: middle-center; white-space: normal; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-sw-lock { position: absolute; left: 0; right: 0; bottom: 2px; font-size: 9px; -unity-text-align: middle-center; color: rgb(255, 255, 255); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-sw-worn { position: absolute; right: 3px; top: 1px; font-size: 13px; color: rgb(200, 255, 61); }
.k-sw-more { width: 22px; font-size: 18px; color: rgba(200, 255, 61, 0.7); -unity-text-align: middle-center; }
.k-lk-info { width: 380px; margin: 0; }
.k-lk-item { font-size: 40px; margin-top: -6px; white-space: normal; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-lk-state { align-self: flex-start; margin: 10px 0 12px 0; padding: 4px 12px; border-radius: 12px; font-size: 12px; letter-spacing: 2px; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-lk-state--worn { color: rgb(14, 15, 18); background-color: rgb(200, 255, 61); }
.k-lk-state--owned { color: rgb(200, 255, 61); border-width: 1px; border-color: rgb(200, 255, 61); }
.k-lk-state--locked { color: rgb(14, 15, 18); background-color: rgb(255, 184, 59); }
.k-lk-how { font-size: 14px; margin-bottom: 8px; white-space: normal; color: rgba(255, 255, 255, 0.85); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }
.k-lk-count { font-size: 11px; margin-top: 8px; color: rgba(255, 255, 255, 0.55); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.lk-card--big { width: 640px; height: 400px; margin-top: 40px; padding: 34px 40px; border-left-width: 10px; border-radius: 16px; }
.lk-card--big .lk-card-name { font-size: 64px; }
.lk-card--big .lk-card-title { font-size: 16px; }

/* ---------- stats ---------- */
.k-st-grid { flex-direction: row; flex-grow: 1; }
.k-st-wide { flex-grow: 1; margin: 0 24px 0 0; }
.k-st-tiles { width: 520px; flex-direction: row; flex-wrap: wrap; align-content: flex-start; }
.k-st-tiles > .k-cr-tile { width: 240px; min-width: 0; margin: 0 20px 20px 0; padding: 24px 10px; }
.k-st-bar { flex-direction: row; align-items: center; height: 64px; border-bottom-width: 1px; border-bottom-color: rgba(255, 255, 255, 0.06); }
.k-st-bar-n { width: 190px; font-size: 22px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-st-track { flex-grow: 1; height: 14px; border-radius: 7px; margin-right: 18px; background-color: rgba(255, 255, 255, 0.07); }
.k-st-fill { height: 14px; border-radius: 7px; background-color: rgb(200, 255, 61); }
.k-st-fill--err { background-color: rgb(255, 90, 74); }
.k-st-bar-pct { width: 70px; font-size: 22px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-st-bar-v { width: 90px; font-size: 14px; -unity-text-align: middle-right; color: rgba(255, 255, 255, 0.75); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-st-mix { flex-direction: row; align-items: center; }
.k-st-donutbox { width: 380px; height: 380px; justify-content: center; align-items: center; }
.k-donut { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.k-st-donut-n { font-size: 56px; color: rgb(255, 255, 255); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-st-donut-k { font-size: 11px; letter-spacing: 3px; color: rgba(255, 255, 255, 0.55); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-st-legend { flex-grow: 1; margin-left: 30px; }
.k-st-leg { flex-direction: row; align-items: center; height: 54px; }
.k-st-leg-dot { width: 16px; height: 16px; border-radius: 8px; margin-right: 14px; }
.k-st-leg-n { width: 140px; font-size: 22px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-st-leg-v { font-size: 14px; color: rgba(255, 255, 255, 0.75); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }

/* ---------- achievements: medallions ---------- */
.k-ach-head { flex-direction: row; align-items: center; margin: -8px 0 16px 0; }
.k-ach-total { font-size: 34px; margin-right: 20px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-ach-tiercount { flex-direction: row; align-items: center; margin-left: 14px; }
.k-ach-tierdot { width: 16px; height: 16px; border-radius: 8px; margin-right: 6px; }
.k-ach-tiern { font-size: 18px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-ach-page { flex-direction: row; flex-grow: 1; }
.k-ach-grid { flex-grow: 1; flex-direction: row; flex-wrap: wrap; align-content: flex-start; margin-right: 24px; }
.k-medal { width: 190px; height: 210px; align-items: center; margin: 0 14px 18px 0; padding-top: 14px; border-radius: 14px; background-color: rgba(16, 18, 22, 0.85); border-width: 1px; border-color: rgba(255, 255, 255, 0.07); transition-property: scale; transition-duration: 0.12s; }
.k-medal.fe-item--focused { scale: 1.06 1.06; border-color: rgb(200, 255, 61); border-width: 2px; }
.k-medal-disc { width: 112px; height: 112px; border-radius: 56px; border-width: 6px; justify-content: center; align-items: center; background-color: rgba(255, 255, 255, 0.04); opacity: 0.55; }
.k-medal-disc--done { opacity: 1; }
.k-medal-mark { font-size: 34px; color: rgba(255, 255, 255, 0.85); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-medal-disc--done .k-medal-mark { color: rgb(14, 15, 18); }
.k-medal-name { margin-top: 12px; font-size: 18px; -unity-text-align: upper-center; white-space: normal; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-ach-detail { width: 460px; margin: 0; }
.k-ach-reward { flex-direction: row; align-items: center; margin-top: 18px; padding: 12px; border-radius: 10px; background-color: rgba(255, 255, 255, 0.05); }
.k-ach-reward > .k-sw { margin: 0 14px 0 0; }
.k-ach-reward-n { font-size: 18px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }

/* ---------- settings ---------- */
.k-set-page { flex-direction: row; flex-grow: 1; }
.k-set-panel { width: 1100px; margin: 0 24px 0 0; }
.k-set-row { margin-bottom: 12px; }
.k-set-row > .k-sel, .k-set-row > .k-carousel { margin-bottom: 4px; }
.k-set-row > .k-carousel { width: auto; height: 76px; }
.k-set-row .k-car-value { width: 340px; font-size: 34px; }
.k-set-hint { font-size: 12px; margin-left: 18px; color: rgba(255, 255, 255, 0.55); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }
.k-set-panel > .k-action { width: 360px; margin-top: 10px; }
.k-set-preview { flex-grow: 1; margin: 0; }
.k-set-pv-row { flex-direction: row; justify-content: space-around; margin: 20px 0 30px 0; }
.k-set-pv-box { width: 160px; height: 160px; justify-content: center; align-items: center; border-radius: 12px; background-color: rgb(96, 100, 108); }
.k-set-pv-box--ball { background-color: rgb(232, 222, 196); }
.k-set-pv-box--ball .k-cr-tile-n { color: rgba(14, 15, 18, 0.7); }
.k-set-ball { background-color: rgb(30, 30, 30); border-width: 2px; border-color: rgba(255, 255, 255, 0.5); margin-bottom: 12px; }
.k-set-ring { width: 70px; height: 70px; border-radius: 35px; border-width: 4px; margin-bottom: 12px; }
.k-set-call { align-self: center; padding: 10px 22px; border-left-width: 6px; border-left-color: rgb(200, 255, 61); background-color: rgba(12, 13, 16, 0.92); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }

/* ---------- controls ---------- */
.k-ctl-grid { flex-direction: row; flex-wrap: wrap; }
.k-ctl { width: 846px; flex-direction: row; align-items: center; height: 58px; margin: 0 18px 10px 0; padding: 0 18px; border-radius: 10px; background-color: rgba(16, 18, 22, 0.88); }
.k-ctl-action { width: 280px; font-size: 22px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-ctl-keys { flex-direction: row; align-items: center; flex-shrink: 1; }
.k-ctl-key { padding: 4px 10px; border-radius: 6px; font-size: 13px; color: rgb(14, 15, 18); background-color: rgb(220, 222, 226); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-ctl-key--pad { background-color: rgb(200, 255, 61); }
.k-ctl-or { margin: 0 10px; color: rgba(255, 255, 255, 0.4); }

/* ---------- dialogs: a small centred panel ---------- */
.k-confirm {
    position: absolute; left: 50%; top: 50%; bottom: auto; height: auto; width: 760px; translate: -50% -50%; padding: 40px 44px 80px 44px;
    border-radius: 18px; background-color: rgba(12, 13, 16, 0.97); border-width: 1px; border-color: rgba(255, 255, 255, 0.1); border-top-width: 4px; border-top-color: rgb(200, 255, 61);
}
.k-confirm .fe-title { font-size: 42px; white-space: normal; margin-bottom: 10px; }
.k-confirm-text { font-size: 15px; margin-bottom: 18px; white-space: normal; color: rgba(255, 255, 255, 0.75); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }
.k-confirm-row { flex-direction: row; margin-top: 12px; }
.k-confirm-row > .k-action { flex-grow: 1; flex-basis: 0; margin: 0 8px 0 0; height: 70px; }
.k-prompts--confirm { left: 44px; bottom: 26px; }

/* ---------- HUD: flips, the lower third, the strip ---------- */
.sb-score { transition-property: scale, translate; transition-duration: 0.16s; }
.sb-score--flip { scale: 1 0.2; translate: 0 -10px; }
.sb-games { transition-property: background-color, scale; transition-duration: 0.25s; }
.sb-games--flash { background-color: rgb(200, 255, 61); color: rgb(14, 15, 18); scale: 1.15 1.15; }
.hud-third {
    position: absolute; left: 96px; bottom: 150px; padding: 12px 28px 14px 22px; border-left-width: 8px; border-left-color: rgb(200, 255, 61);
    background-color: rgba(12, 13, 16, 0.92); translate: -60px 0; opacity: 0;
    transition-property: translate, opacity; transition-duration: 0.22s; transition-timing-function: ease-out-cubic;
}
.hud-third--in { translate: 0 0; opacity: 1; }
.hud-third-call { font-size: 40px; color: rgb(255, 255, 255); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.hud-third-sub { font-size: 13px; letter-spacing: 2px; margin-top: -2px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.hud-strip {
    position: absolute; left: 50%; bottom: 46px; translate: -50% 0; flex-direction: row; align-items: center;
    padding: 8px 16px; border-radius: 22px; background-color: rgba(12, 13, 16, 0.88);
}
.hud-strip-key { padding: 3px 10px; margin-right: 12px; border-radius: 6px; font-size: 13px; color: rgb(14, 15, 18); background-color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.hud-strip-text { font-size: 15px; color: rgb(255, 255, 255); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }

.fe-version { font-size: 12px; color: rgba(255, 255, 255, 0.45); margin-top: 18px; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }

/* ---------- free play counts (practice court) ---------- */
.ph-count { position: absolute; top: 24px; right: 28px; padding: 10px 16px; border-radius: 10px; background-color: rgba(12, 13, 16, 0.85); align-items: flex-end; }
.ph-hits { font-size: 30px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.ph-run { font-size: 13px; color: rgb(255, 255, 255); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }

/* ---------- LET? over the striker (P2-M7) ---------- */
.hud-let {
    position: absolute; flex-direction: row; align-items: center;
    padding: 4px 6px 4px 12px; border-radius: 16px; background-color: rgba(12, 13, 16, 0.88);
    border-width: 2px; border-color: rgb(200, 255, 61);
}
.hud-let-word { font-size: 20px; color: rgb(200, 255, 61); margin-right: 8px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.hud-let-key { padding: 2px 8px; border-radius: 6px; font-size: 12px; color: rgb(14, 15, 18); background-color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }

/* ---------- the arcade marquee ---------- */
.ah-panel { width: 440px; padding: 14px 18px; border-left-width: 6px; border-left-color: rgb(200, 255, 61); }
.ah-top { flex-direction: row; align-items: center; justify-content: space-between; }
.ah-left { flex-grow: 1; }
.ah-score { font-size: 64px; margin-top: -8px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.ah-clock { width: 84px; height: 84px; justify-content: center; align-items: center; }
.ah-clock > .ah-line { font-size: 18px; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.ah-combo-bar { height: 8px; border-radius: 4px; margin: 6px 0 4px 0; background-color: rgba(255, 255, 255, 0.08); }
.ah-combo-fill { height: 8px; border-radius: 4px; background-color: rgb(255, 207, 58); }

/* ---------- toasts: medallions sliding in ---------- */
.toasts { width: 440px; }
.toast {
    flex-direction: row; align-items: center; width: 420px; padding: 12px 16px; margin-bottom: 10px; border-radius: 12px; white-space: normal;
    background-color: rgba(12, 13, 16, 0.96); border-width: 1px; border-color: rgba(255, 255, 255, 0.1); border-left-width: 5px; border-left-color: rgb(200, 255, 61);
    transition-property: translate, opacity; transition-duration: 0.25s; transition-timing-function: ease-out-back;
}
.toast--in { translate: 460px 0; }
.toast-medal { width: 52px; height: 52px; border-radius: 26px; margin-right: 14px; -unity-text-align: middle-center; font-size: 18px; color: rgb(14, 15, 18); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.toast-words { flex-shrink: 1; }
.toast-kicker { font-size: 10px; letter-spacing: 2px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.toast-text { font-size: 22px; white-space: normal; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }

/* ================= P2-M6: the replay theatre ================= */

/* ---------- library ---------- */
.k-rl-row { align-items: flex-start; }
.k-card--replay { width: 318px; height: 470px; margin-right: 20px; }
.k-card--replay .k-card-title { font-size: 28px; }

/* ---------- a match ---------- */
.k-rp-head { flex-direction: row; align-items: center; margin-bottom: 18px; }
.k-rp-result { padding: 4px 16px; margin-right: 18px; border-radius: 8px; font-size: 30px; color: rgb(255, 255, 255); background-color: rgba(255, 255, 255, 0.1); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-rp-result--won { color: rgb(14, 15, 18); background-color: rgb(200, 255, 61); }
.k-rp-head > .k-ft-chips { margin: 0 18px 0 0; }
.k-rp-meta { font-size: 13px; color: rgba(255, 255, 255, 0.75); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-rp-old { margin-left: 18px; padding: 3px 10px; border-radius: 10px; font-size: 11px; color: rgb(14, 15, 18); background-color: rgb(255, 184, 59); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-rp-progress { flex-grow: 1; -unity-text-align: middle-right; font-size: 12px; letter-spacing: 2px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-rp-card { width: 620px; min-height: 300px; margin: 0 0 24px 0; }
.k-rp-score { flex-direction: row; align-items: center; margin-bottom: 6px; }
.k-rp-before { font-size: 40px; color: rgba(255, 255, 255, 0.6); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-rp-arrow { font-size: 28px; margin: 0 16px; color: rgb(200, 255, 61); }
.k-rp-after { font-size: 48px; color: rgb(255, 255, 255); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-rp-call { font-size: 26px; margin-bottom: 12px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-rp-facts { flex-direction: row; margin-bottom: 12px; }
.k-rp-fact { margin-right: 10px; padding: 4px 10px; border-radius: 6px; font-size: 13px; background-color: rgba(255, 255, 255, 0.06); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-rp-tags { flex-direction: row; flex-wrap: wrap; }
.k-rp-tag { margin: 0 8px 8px 0; padding: 3px 10px; border-radius: 12px; font-size: 11px; letter-spacing: 1px; color: rgb(14, 15, 18); background-color: rgb(255, 184, 59); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-rp-strip { position: absolute; left: 0; right: 0; bottom: 0; margin: 0; }
.k-rp-scroll { height: 74px; }
.k-rp-nodes { flex-direction: row; align-items: center; height: 60px; padding: 0 8px; }
.k-rnode { width: 26px; height: 48px; margin-right: 4px; align-items: center; justify-content: center; border-radius: 6px; transition-property: scale; transition-duration: 0.1s; }
.k-rnode.fe-item--focused { background-color: rgba(200, 255, 61, 0.18); scale: 1.3 1.3; }
.k-rnode-dot { width: 16px; height: 16px; border-radius: 8px; }
.k-rnode-dot--p0 { background-color: rgb(200, 255, 61); }
.k-rnode-dot--p1 { background-color: rgb(255, 90, 74); }
.k-rnode-dot--let { background-color: rgba(255, 255, 255, 0.4); }
.k-rnode-tag { width: 6px; height: 6px; border-radius: 3px; margin-top: 6px; background-color: rgb(255, 184, 59); }
.k-rnode--wait { opacity: 0.3; }
.k-rnode-gap { width: 26px; height: 40px; border-left-width: 2px; border-left-color: rgba(255, 255, 255, 0.25); margin-left: 12px; }

/* ---------- watching: a minimal overlay ---------- */
.k-theatre { position: absolute; left: 0; top: 0; right: 0; bottom: 0; width: auto; padding: 0; background-image: none; transition-property: opacity; transition-duration: 0.2s; }
.k-theatre .fe-title, .k-theatre .fe-kicker { display: none; }
.k-th-bug { position: absolute; left: 40px; top: 36px; width: 380px; padding: 8px 14px; border-radius: 10px; background-color: rgba(12, 13, 16, 0.9); border-left-width: 5px; border-left-color: rgb(200, 255, 61); }
.k-th-row { flex-direction: row; align-items: center; height: 36px; }
.k-th-serve { width: 10px; height: 10px; border-radius: 5px; margin-right: 10px; }
.k-th-serve--on { background-color: rgb(200, 255, 61); }
.k-th-name { flex-grow: 1; font-size: 22px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.k-th-games { width: 30px; font-size: 16px; color: rgba(255, 255, 255, 0.6); -unity-text-align: middle-center; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-th-points { width: 44px; font-size: 26px; color: rgb(200, 255, 61); -unity-text-align: middle-right; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-th-top { position: absolute; left: 50%; top: 36px; translate: -50% 0; align-items: center; }
.k-th-rally { padding: 6px 14px; border-radius: 8px; font-size: 13px; letter-spacing: 2px; background-color: rgba(12, 13, 16, 0.9); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-th-tagbox { margin-top: 10px; }
.k-th-third { bottom: 170px; left: 40px; }
.k-th-bar {
    position: absolute; left: 40px; right: 40px; bottom: 70px; height: 64px; flex-direction: row; align-items: center; padding: 0 20px;
    border-radius: 14px; background-color: rgba(12, 13, 16, 0.92);
}
.k-th-play { width: 40px; font-size: 22px; color: rgb(200, 255, 61); -unity-text-align: middle-center; }
.k-th-track { flex-grow: 1; height: 12px; margin: 0 20px; border-radius: 6px; background-color: rgba(255, 255, 255, 0.12); }
.k-th-fill { height: 12px; border-radius: 6px; background-color: rgb(200, 255, 61); }
.k-th-ticks { position: absolute; left: 0; right: 0; top: -6px; height: 24px; }
.k-th-tick { position: absolute; top: 0; width: 3px; height: 24px; margin-left: -1px; border-radius: 1px; background-color: rgba(200, 255, 61, 0.9); }
.k-th-tick--p1 { background-color: rgba(255, 90, 74, 0.9); }
.k-th-time { width: 110px; font-size: 14px; -unity-text-align: middle-center; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-th-chip { margin-left: 10px; padding: 4px 12px; border-radius: 12px; font-size: 12px; letter-spacing: 1px; background-color: rgba(255, 255, 255, 0.1); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-th-prompts { left: 40px; bottom: 22px; padding: 6px 14px; border-radius: 10px; background-color: rgba(12, 13, 16, 0.85); }

/* ---- PR5: broadcast touches ---- */
.hud-ball {
    position: absolute; left: 20px; top: 176px; padding: 4px 12px; border-radius: 6px;
    font-size: 13px; letter-spacing: 2px; color: rgb(14, 15, 18); background-color: rgb(200, 255, 61);
    -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold");
}
.hud-rally {
    position: absolute; left: 50%; top: 22px; translate: -50% 0; padding: 5px 16px; border-radius: 16px;
    font-size: 15px; letter-spacing: 3px; color: rgb(255, 255, 255); background-color: rgba(12, 13, 16, 0.86);
    border-width: 1px; border-color: rgba(200, 255, 61, 0.5);
    -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold");
    transition-property: background-color, color, scale; transition-duration: 0.25s;
}
.hud-rally--hot { background-color: rgb(200, 255, 61); color: rgb(14, 15, 18); scale: 1.08 1.08; }
.hud-intro {
    position: absolute; left: 50%; bottom: 120px; translate: -50% 30px; opacity: 0; align-items: center;
    padding: 16px 40px 18px 40px; background-color: rgba(12, 13, 16, 0.92);
    border-top-width: 4px; border-top-color: rgb(200, 255, 61);
    transition-property: translate, opacity; transition-duration: 0.3s; transition-timing-function: ease-out-cubic;
}
.hud-intro--in { translate: -50% 0; opacity: 1; }
.hud-intro-names { font-size: 44px; color: rgb(255, 255, 255); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.hud-intro-sub { font-size: 13px; letter-spacing: 3px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }

/* ---- P3-R2: challenges ---- */
.ch-grid { flex-direction: row; flex-wrap: wrap; align-items: flex-start; }
.ch-today { width: 860px; margin: 0 20px 20px 0; }
.ch-week { width: 620px; margin: 0 0 20px 0; }
.ch-streak { width: 620px; margin: 0 0 20px 0; }
