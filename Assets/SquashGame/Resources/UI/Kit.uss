.on-row-name { flex-grow: 1; color: rgb(255, 255, 255); font-size: 18px; }
.on-row-wl { width: 90px; color: rgba(255, 255, 255, 0.6); font-size: 16px; -unity-text-align: middle-right; }
.on-row-rating { width: 80px; color: rgb(200, 255, 61); font-size: 18px; -unity-text-align: middle-right; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }

/* 2026-10-25 playtest fixes */
.k-quiz-ring {
    position: absolute; width: 72px; height: 72px; border-radius: 36px;
    border-width: 4px; border-color: rgb(200, 255, 61); background-color: rgba(200, 255, 61, 0.08);
}
.k-fade-top { position: absolute; left: 0; right: 0; top: 0; height: 26%; -unity-background-scale-mode: stretch-to-fill; }
.gt-line { font-size: 20px; color: rgb(255, 255, 255); padding: 8px 14px; border-radius: 8px; background-color: rgba(14, 15, 18, 0.92); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.gd-icon { position: absolute; left: 0; right: 0; top: 6%; bottom: 6%; width: auto; height: auto; margin: 0; }
.k-vs-hint { font-size: 12px; margin: -2px 0 10px 0; white-space: normal; max-width: 420px; color: rgba(255, 255, 255, 0.6); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }

/* the profile (the player tag opens it) */
.k-chip-item { flex-direction: row; border-radius: 40px; }
.k-chip-item.fe-item--focused > .k-chip { border-color: rgb(200, 255, 61); background-color: rgba(30, 36, 18, 0.95); }
.pf-grid { flex-direction: row; align-items: flex-start; }
.pf-panel { width: 560px; margin-right: 24px; }
.pf-you { width: 420px; margin-right: 24px; align-items: center; }
.pf-pic { width: 300px; height: 360px; border-radius: 12px; overflow: hidden; margin-bottom: 12px; }
.pf-level { font-size: 22px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.pf-saved { font-size: 13px; margin-top: 8px; color: rgb(200, 255, 61); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.pf-more { flex-direction: row; margin-top: 16px; }
.pf-row { flex-direction: row; justify-content: space-between; padding: 8px 0; border-bottom-width: 1px; border-color: rgba(255, 255, 255, 0.07); }
.pf-row-k { font-size: 16px; color: rgba(255, 255, 255, 0.65); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.pf-row-v { font-size: 18px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }

/* P5 the Gauntlet roguelite */
.gt-more { flex-direction: row; margin-top: 14px; }
.gt-unlock { font-size: 18px; margin-bottom: 10px; color: rgb(255, 184, 59); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.gt-trait { font-size: 16px; margin: 6px 0; white-space: normal; color: rgb(255, 120, 90); -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.gt-ab { flex-direction: row; justify-content: space-between; padding: 4px 0; }
.gt-ab-name { font-size: 17px; -unity-font-definition: resource("UI/Fonts/Rajdhani-Bold"); }
.gt-ab-pips { font-size: 14px; color: rgba(255, 255, 255, 0.75); }
.gt-codex { flex-direction: row; flex-wrap: wrap; align-items: flex-start; }
.gt-codex-panel { width: 330px; margin-right: 16px; margin-bottom: 14px; }
