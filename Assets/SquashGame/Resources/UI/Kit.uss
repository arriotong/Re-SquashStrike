.ch-streak-k { font-size: 18px; letter-spacing: 3px; margin-bottom: 8px; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }

/* ---- P3-R3: career attributes ---- */
.k-cr-attr { margin-bottom: 16px; }
.k-cr-attr-row { flex-direction: row; align-items: center; margin-top: 8px; }
.k-cr-attr-name { width: 110px; font-size: 15px; letter-spacing: 1px; -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Bold"); }
.k-cr-attr-bar { flex-grow: 1; height: 10px; border-radius: 5px; background-color: rgba(255, 255, 255, 0.08); overflow: hidden; }
