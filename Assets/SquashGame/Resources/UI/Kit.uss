.k-cr-attr-line { font-size: 11px; margin: 2px 0 0 110px; color: rgba(255, 255, 255, 0.55); -unity-font-definition: resource("UI/Fonts/JetBrainsMono-Medium"); }

/* ---- P3-R4: goals and sponsors ---- */
.k-cr-ggrid { flex-direction: row; align-items: flex-start; }
.k-cr-goals { width: 900px; margin-right: 20px; }
.k-cr-sponsor { width: 620px; }
