<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    P2-M8 online: the relay server. Pairs players (private rooms by code,
    quick match, ranked), relays their inputs, and steps its own copy of
    every match from them (SquashSim.Core, linked as MatchBench links it)
    so a result never rests on what a client says. Ratings and players in
    a JSON file (no packages to fetch: ASP.NET Core ships with the SDK).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>SquashServer</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/SquashSim/**/*.cs" LinkBase="SquashSim" />
  </ItemGroup>
</Project>
